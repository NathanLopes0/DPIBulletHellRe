{
  // ==========================================================================
  // AS MATERIAS DO CURSO
  //
  // Esta lista era um enum em Game.h e mais cinco lugares em C++ que repetiam
  // pedacos dela: o mapa de chefes, os nomes em tela, as colunas (duplicadas
  // entre StageSelect e as regras de desbloqueio, com nomes trocados), a
  // quantidade e o tamanho de cada coluna. Mudar uma materia exigia acertar os
  // seis, e esquecer um deles nao dava erro de compilacao.
  //
  // O "codigo" E A CHAVE, e esse e o ponto mais importante do arquivo.
  //
  // Antes, o que ia para o save do aluno era a POSICAO da materia no enum: INF
  // 213 valia 0 porque estava em primeiro lugar. Inserir uma materia no comeco
  // reinterpretava todos os saves ja gravados EM SILENCIO - uma nota 85 de INF
  // 213 virava nota de outra materia, e o aluno abria o jogo aprovado em coisa
  // que nunca jogou. Medi isso antes de mexer: tres de tres notas mudavam de
  // dona sem um unico erro.
  //
  // Com um codigo de texto, reordenar esta lista, renomear uma materia em tela
  // ou inserir outra no meio nao mexe em save nenhum. O que NAO pode mudar e o
  // codigo em si - trocar "INF213" por outra coisa e, para o jogo, aposentar
  // aquela materia e criar outra.
  //
  // CAMPOS
  //   codigo        a chave estavel. So letras e numeros, sem espaco.
  //   nome          o que aparece no losango. Pode mudar a vontade.
  //   nomeCompleto  o nome da disciplina. Opcional; vazio e so nao mostrar.
  //   professor     quem da a materia. Opcional, e INDEPENDENTE de "chefe":
  //                 a INF 330 e do Salles e ainda nao tem batalha, e o Salles
  //                 ja e o chefe da INF 213 - sao coisas diferentes.
  //   coluna        0 a 4, a posicao na grade da selecao de fase. A coluna
  //                 tambem e o que as regras de desbloqueio usam, entao ela e
  //                 declarada UMA vez e nao duas.
  //   chefe         qual chefe esta materia usa. Vazio ou ausente = batalha
  //                 ainda nao feita: o losango aparece e nao da para jogar.
  //   desbloqueio   quando a materia abre. Ver abaixo.
  //
  // REGRAS DE DESBLOQUEIO
  //   { "tipo": "sempre" }
  //   { "tipo": "aprovadoEm", "materias": ["INF213"] }
  //       exige aprovacao em TODAS as listadas.
  //   { "tipo": "aprovadasNaColuna", "quantas": 2, "coluna": 1 }
  //       exige N aprovacoes entre as materias daquela coluna. Usa a coluna em
  //       vez de repetir a lista, para nao haver duas versoes do mesmo conjunto.
  // ==========================================================================

  "materias": [

    // ----- Coluna 0: a porta de entrada do curso -----
    //
    // O Andre mudou de materia: ele era o chefe de INF 330 e passou a ser o da
    // INF 110, que e por onde o aluno comeca. Como o save grava o CODIGO da
    // materia, mover um chefe de uma para outra nao mexe em nota de ninguem.
    {
      "codigo": "INF110",
      "nome": "INF 110",
      "nomeCompleto": "Programação 1",
      "professor": "André",
      "coluna": 0,
      "chefe": "andre",
      "desbloqueio": { "tipo": "sempre" }
    },

    // ----- Coluna 1: abre ao passar em INF 110 -----
    //
    // O INF 213 era a porta de entrada e virou o segundo degrau.
    {
      "codigo": "INF213", "nome": "INF 213",
      "nomeCompleto": "Estruturas de Dados", "professor": "Salles",
      "coluna": 1, "chefe": "salles",
      "desbloqueio": { "tipo": "aprovadoEm", "materias": ["INF110"] }
    },

    // ----- Coluna 2: abre ao passar em INF 213 -----
    {
      "codigo": "INF250", "nome": "INF 250",
      "nomeCompleto": "Organização de Computadores", "professor": "Ricardo",
      "coluna": 2, "chefe": "ricardo",
      "desbloqueio": { "tipo": "aprovadoEm", "materias": ["INF213"] }
    },
    {
      "codigo": "INF220", "nome": "INF 220",
      "nomeCompleto": "Banco de Dados", "professor": "Thiago",
      "coluna": 2, "chefe": "thiago",
      "desbloqueio": { "tipo": "aprovadoEm", "materias": ["INF213"] }
    },
    {
      // Mesmo professor da INF 213, e ainda assim sem batalha: o chefe do
      // Salles e a luta da INF 213. Por isso "professor" e "chefe" sao campos
      // diferentes - reaproveitar o chefe faria duas materias identicas.
      "codigo": "INF330", "nome": "INF 330",
      "nomeCompleto": "Teoria e Modelos de Grafos", "professor": "Salles",
      "coluna": 2,
      "desbloqueio": { "tipo": "aprovadoEm", "materias": ["INF213"] }
    },
    {
      "codigo": "INF331", "nome": "INF 331",
      "nomeCompleto": "Linguagens Formais e Autômatos", "professor": "Vladimir",
      "coluna": 2,
      "desbloqueio": { "tipo": "aprovadoEm", "materias": ["INF213"] }
    },

    // ----- Coluna 3: abre com duas aprovacoes na coluna 2 -----
    {
      "codigo": "INF420", "nome": "INF 420",
      "nomeCompleto": "Inteligência Artificial", "professor": "Júlio",
      "coluna": 3, "chefe": "julio",
      "desbloqueio": { "tipo": "aprovadasNaColuna", "quantas": 2, "coluna": 2 }
    },
    {
      "codigo": "INF221", "nome": "INF 221",
      "nomeCompleto": "Engenharia de Software", "professor": "Maria Lúcia",
      "coluna": 3,
      "desbloqueio": { "tipo": "aprovadasNaColuna", "quantas": 2, "coluna": 2 }
    },
    {
      "codigo": "INF321", "nome": "INF 321",
      "nomeCompleto": "Programação Web", "professor": "Lucas",
      "coluna": 3,
      "desbloqueio": { "tipo": "aprovadasNaColuna", "quantas": 2, "coluna": 2 }
    },
    {
      "codigo": "INF452", "nome": "INF 452",
      "nomeCompleto": "Redes de Computadores", "professor": "Vitor",
      "coluna": 3,
      "desbloqueio": { "tipo": "aprovadasNaColuna", "quantas": 2, "coluna": 2 }
    },

    // ----- Coluna 4: o fim do curso -----
    {
      "codigo": "TCC", "nome": "TCC",
      "nomeCompleto": "Trabalho de Conclusão de Curso", "professor": "Hugo",
      "coluna": 4,
      "desbloqueio": { "tipo": "aprovadasNaColuna", "quantas": 2, "coluna": 3 }
    }
  ]
}
