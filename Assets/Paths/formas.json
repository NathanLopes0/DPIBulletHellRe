{
  // Formas de trajetoria.

  // ---- Exemplo da forma por pontos literais ----
  "Gancho": {
    "pontos": [[80, 0], [150, 30], [190, 90], [170, 160], [110, 200], [900, 200]]
  },

  // Salles - INF 213 (Estruturas de Dados) So o anel da fase final dele usa forma.

  // ---- Fase final: a lista circular ----
  "LacoLento": {
    "gerador": { "tipo": "Loop", "a": 80, "b": 500, "n": 12 }
  },

  // ---- Formas sem uso hoje, mantidas como vocabulario ----

  // A ida e a volta pelo mesmo rastro: vai 300px, e volta 900px em -X, 180 graus exatos.
  "IdaEVolta": {
    "pontos": [[300, 0], [-900, 0]]
  },

  // A unica familia "arvore" dos dados: "divisoes": 4 quer dizer 1 -> 2 -> 4 -> 8 -> 16, e o leitor
  // gera as dezesseis folhas.
  "ArvoreDeBusca": {
    "arvore": { "divisoes": 4, "tronco": 120, "passo": 90, "espacamento": 60, "saida": 560 }
  },

  "ZigueQuinado": {
    "gerador": { "tipo": "Zigzag", "a": 85, "b": 50, "n": 6 }
  },
  // O par existe para alternar o lado entre projeteis vizinhos (pares recebem um, impares o outro):
  // as barrigas se cruzam no meio do voo.
  "ArcoDireita": {
    "gerador": { "tipo": "Arc", "a": 500, "b": 110, "n": 10 }
  },
  "ArcoEsquerda": {
    "gerador": { "tipo": "Arc", "a": 500, "b": -110, "n": 10 }
  },

  // ---- Julio, fase final ----
  "LacoApertado": {
    "gerador": { "tipo": "Loop", "a": 70, "b": 500, "n": 12 }
  },

  // Maria Lucia - INF 221 (Engenharia de Software)

  // ---- Fase 2: as setas de um diagrama ----
  "RotasDeDiagrama": {
    "caminhos": [
      [[ 40, 0], [ 40, -110], [820, -110]],
      [[ 65, 0], [ 65,  110], [820,  110]],
      [[ 95, 0], [ 95, -210], [820, -210]],
      [[125, 0], [125,  210], [820,  210]],
      [[155, 0], [155, -310], [820, -310]],
      [[185, 0], [185,  310], [820,  310]],
      [[210, 0], [210, -420], [820, -420]],
      [[230, 0], [230,  420], [820,  420]]
    ]
  },

  // ---- Fase 3 e final: onde a divida para ----
  "ParaEFica": {
    "pontos": [[460, 0], [1200, 0]]
  },

  // O olho que assina (Maria Lucia, fase 3 - o padrao Observer): sai da professora, para a 230px
  // dela e fica olhando o aluno ate "pararPor" acabar.
  "Inscrito": {
    "pontos": [[230, 0], [1400, 0]]
  }
}
