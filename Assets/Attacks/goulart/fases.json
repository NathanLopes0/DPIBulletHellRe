      { "nome": "Elasticidade", "duracao": 7.0, "anuncio": "Elasticidade: a carga sobe" }
    ],
    "movimento": { "tipo": "Orbitar", "a": 150, "b": 0.10 },
    "ataques": [
      { "gatilho": "vm", "estrategia": "WaveAttack", "projetil": "Vm",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "kernel", "estrategia": "WaveAttack", "projetil": "Pacote",
