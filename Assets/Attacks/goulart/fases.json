{
  // As fases do Goulart (INF 451 - Sistemas Operacionais). O que cada uma faz mora no C++
  // (Goulart.cpp) e na camada pura (Escalonador.h, Paginacao.h, Disco.h, Virtualizacao.h); aqui
  // ficam os tiros que ele puxa pelo gatilho, e os nomes que o placar mostra.

  // ==========================================================================

  // Fase 1 - os processos: o escalonador Round Robin | gesto: a CPU anda devagar no alto. O campo
  // e dividido em faixas, uma por processo: chove na faixa de quem esta na CPU, e a do proximo da fila
  // fica marcada. O placar e reescrito pelo C++ com o estado das filas.
  "StateOne": {
    "duracao": 20,
    "proximo": "StateTwo",
    "anuncio": "Processos: as faixas da CPU",
    "movimento": { "tipo": "Conduzido", "a": 240 },
    "ataques": [
      { "gatilho": "processo", "estrategia": "WaveAttack", "projetil": "Processo",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "titulo", "estrategia": "WaveAttack", "projetil": "Titulo",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "instrucao", "estrategia": "WaveAttack", "projetil": "Instrucao",
        "projeteis": 1, "velocidade": 270, "angulo": 0, "intervalo": 0 }
    ]
  },

  // Fase 2 - a memoria: a paginacao | gesto: o professor anda devagar no alto. O chao sao as oito
  // paginas, e a coluna em que o aluno esta e a pagina lida; a falta despeja uma vitima, e a coluna
  // dela desaba. A memoria fisica e um relogio de molduras, e encolhe a cada etapa.
  "StateTwo": {
    "duracao": 20,
    "proximo": "StateThree",
    "anuncio": "Memória: a paginação",
    "etapas": [
      { "nome": "Localidade", "duracao": 8.0, "anuncio": "Você é a referência: fique em poucas páginas" },
      { "nome": "Mudanca",    "duracao": 5.0, "anuncio": "A memória encolheu: uma moldura a menos" },
      { "nome": "Thrashing",  "duracao": 7.0, "anuncio": "Thrashing: três molduras, oito páginas" }
    ],
    "movimento": { "tipo": "Conduzido", "a": 200 },
    "ataques": [
      { "gatilho": "moldura", "estrategia": "WaveAttack", "projetil": "Moldura",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "entrada", "estrategia": "WaveAttack", "projetil": "Entrada",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "acesso", "estrategia": "WaveAttack", "projetil": "Instrucao",
        "projeteis": 3, "velocidade": 230, "angulo": 18, "intervalo": 0, "dificil": { "projeteis": 5, "velocidade": 255 },
        "regras": "acesso" },
      { "gatilho": "vitima", "estrategia": "WaveAttack", "projetil": "Vitima",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "pagina", "estrategia": "WaveAttack", "projetil": "Pagina",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 }
    ]
  },

  // Fase 3 - a entrada e saida: o braco do disco | gesto: o professor e o braco, e vai aonde o
  // algoritmo da etapa manda. O bloco lido cai na coluna do pedido; a linha do braco mostra qual e o
  // proximo.
  "StateThree": {
    "duracao": 20,
    "proximo": "",
    "anuncio": "Entrada e saída: o disco",
    "etapas": [
      { "nome": "FCFS", "duracao": 6.0, "anuncio": "FCFS: na ordem de chegada" },
      { "nome": "SSTF", "duracao": 7.0, "anuncio": "SSTF: o mais perto primeiro" },
      { "nome": "SCAN", "duracao": 7.0, "anuncio": "SCAN: o elevador" }
    ],
    "movimento": { "tipo": "Conduzido", "a": 380 },
    "ataques": [
      { "gatilho": "requisicao", "estrategia": "WaveAttack", "projetil": "Pedido",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "leitura", "estrategia": "WaveAttack", "projetil": "Bloco",
        "projeteis": 1, "velocidade": 330, "angulo": 0, "intervalo": 0 }
    ]
  },

  // Fase final - a virtualizacao e a nuvem | gesto: a orbita lenta do hipervisor. A VM isola: os
  // tiros do kernel quicam dentro da caixa dela, e so o trap sai. So e vista por quem termina a
  // terceira entre 40 e 59, ou com 100.
