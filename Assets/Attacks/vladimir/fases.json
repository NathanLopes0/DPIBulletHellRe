{
  // ==========================================================================
  // AS FASES DO VLADIMIR (INF 331 - Linguagens Formais e Automatos)
  //
  // AS QUATRO FASES SAO A HIERARQUIA DE CHOMSKY, um nivel por fase. Nao e
  // tema: e a estrutura da disciplina, e a batalha sobe por ela.
  //
  //   StateOne    Regular            (ab)*      um laco de memoria finita
  //   StateTwo    Livre de contexto  a^n b^n    contar exige uma pilha
  //   StateThree  Automato de pilha             a pilha, desenhada de lado
  //   StateFinal  Maquina de Turing             a fita, lida e reescrita
  //
  // O MOVIMENTO DO CHEFE E O ATAQUE, E E ASSIM EM TODAS AS QUATRO.
  //
  // A primeira versao punha GoToCenter em todas, com a justificativa de que
  // "uma palavra precisa de origem fixa para ser lida como palavra". Isso
  // estava errado de um jeito que so jogando aparece: uma palavra se escreve
  // com a caneta ANDANDO. Com o chefe parado, cada rajada caia na mesma coluna
  // do meio, a tela ficava vazia dos lados, e a fase nao tinha o que olhar.
  //
  // Agora cada fase tem o GESTO dela, e o gesto e a ideia da fase:
  //
  //   Orbitar    o laco da estrela de Kleene - a volta que repete
  //   Varredura  o ir-e-voltar de a^n b^n, e a cabeca da fita de Turing
  //   Mergulho   empilhar e desempilhar - a profundidade E a altura da pilha
  //
  // Ver Source/Movements/MovementStrategies.h.
  //
  // OS NOMES DE FASE NAO SAO LIVRES: a maquina de estados procura por texto, e
  // so StateOne, StateTwo, StateThree e StateFinal existem. StateFinal e
  // OBRIGATORIO, mesmo num chefe de tres fases - sem ele, uma nota entre 40 e
  // 59 ao fim da terceira manda a FSM para um estado que nao existe e o chefe
  // CONGELA, sem travar o jogo e sem avisar em tela.
  // ==========================================================================

  // FASE 1 - REGULAR: (ab)*   |   gesto: A ORBITA
  //
  // A ESTRELA DE KLEENE E UM LACO QUE REPETE, e a orbita e o laco. O chefe dá
  // voltas sem parar deixando simbolos pelo anel; cada volta escreve um anel, e
  // a repeticao fica visivel como repeticao.
  //
  // 0,16 VOLTA POR SEGUNDO = 6,25s por volta, e a fase dura 17s: da duas voltas
  // e meia. Mais rapido viraria um borrao e a repeticao sumiria no movimento;
  // mais devagar nao fecharia o anel dentro da fase, e um laco que nao fecha
  // nao se le como laco.
  //
  // O LEQUE DE 40 GRAUS espalha cada rajada em torno da direcao do tiro, e e o
  // que enche o campo junto com a orbita: o anel tem largura, e nao e um fio.
  //
  // UMA RAJADA A CADA 0,9s, e nao 1,1: na foto do quadro 700 a fase estava com
  // o movimento certo e simbolos de menos - oito na tela inteira. Dez a cada
  // 0,9 dao onze por segundo contra os sete de antes, e a trilha da orbita
  // passa a ser continua em vez de tracejada.
  "StateOne": {
    "duracao": 17,
    "proximo": "StateTwo",
    "movimento": { "tipo": "Orbitar", "a": 230, "b": 0.16 },
    "ataques": [
      { "estrategia": "WaveAttack", "projetil": "Simbolo",
        "projeteis": 10, "velocidade": 250, "angulo": 40, "intervalo": 0.06,
        "cooldown": 0.9,
        "regras": "kleene" }
    ]
  },

  // FASE 2 - LIVRE DE CONTEXTO: a^n b^n   |   gesto: A VARREDURA
  //
  // Doze simbolos: seis "a" e depois seis "b". A palavra e lida no TEMPO, e
  // contar o primeiro trecho diz quando o segundo comeca.
  //
  // QUEM DEITA A PALAVRA E O LEQUE, E NAO A VARREDURA. Escrevi o contrario
  // aqui e estava errado - a foto do quadro 1700 mostrou a palavra numa COLUNA
  // vertical enquanto o chefe ja tinha varrido 200 pixels para longe dela.
  //
  // O motivo esta em WaveAttack.cpp: a rajada inteira nasce em
  // params.firePosition, que e lida UMA vez quando o ataque dispara. O
  // "intervalo" atrasa o DESPERTAR de cada simbolo, e nao o nascimento - os
  // doze ja estao no mesmo ponto desde o primeiro quadro. O chefe nao e uma
  // caneta que arrasta tinta; ele e um carimbo.
  //
  // O leque, sim, distribui: angleStart + i * angleStep, EM ORDEM DE INDICE.
  // Com 70 graus a palavra sai escrita num arco, o primeiro "a" numa ponta e o
  // ultimo "b" na outra - e a contagem vira TAMANHO DO TRECHO COLORIDO, que e
  // ainda mais legivel do que contar um por um.
  //
  // A VARREDURA CONTINUA IMPORTANDO, so que entre palavras e nao dentro de
  // uma: com cooldown 3,0 e 170 px/s, duas palavras seguidas nascem a 510
  // pixels uma da outra, e e isso que enche a largura.
  "StateTwo": {
    "duracao": 17,
    "proximo": "StateThree",
    "movimento": { "tipo": "Varredura", "a": 170, "b": 150 },
    "ataques": [
      { "estrategia": "WaveAttack", "projetil": "Simbolo",
        "projeteis": 12, "velocidade": 250, "angulo": 70, "intervalo": 0.09,
        "cooldown": 3.0,
        "regras": "blocos" }
    ]
  },

  // FASE 3 - AUTOMATO DE PILHA   |   gesto: O MERGULHO
  //
  // EMPILHAR E DESCER, DESEMPILHAR E SUBIR. A profundidade do chefe e a altura
  // da pilha, e os simbolos saem PARA OS LADOS em vez de para baixo - cada
  // nivel vira uma linha horizontal no campo, e a pilha fica desenhada.
  //
  // NAO HA "angulo" AQUI, E ISSO NAO E ESQUECIMENTO.
  //
  // CircleSpreadAttack IGNORA params.angle: o passo dela e 360/n, sempre
  // (CircleSpreadAttack.cpp). Eu tinha escrito "angulo": 150 e depois 260
  // tentando achatar o leque, e as duas vezes era TEXTO MORTO - o leitor
  // aceita o campo, a estrategia nao o le, e nada avisa. Perdi uma medicao
  // inteira achando que o arnes e que nao estava pegando o arquivo.
  //
  // Entao o que se controla aqui e a QUANTIDADE. Com 10 simbolos a abertura
  // entre eles e de 36 graus, buraco de sobra para passar sem encostar: medido,
  // a fase dava ZERO acerto em dezessete segundos e a nota subia para 90,98.
  // Com 18 a abertura cai para 20 graus.
  //
  // E O ANEL E O DESENHO DA PILHA. Cada mergulho deixa uma coluna de aneis em
  // alturas diferentes, e cada anel e um nivel - nao sao linhas horizontais
  // como eu tinha imaginado, mas le-se igual, e e o que a estrategia sabe
  // fazer de verdade.
  //
  // Os simbolos FREIAM depois de meio segundo (o SlowDown em regras.json), e e
  // isso que faz o desenho parar de pé em vez de escorrer pelas bordas.
  //
  // PROFUNDIDADE 320 CONTRA 17s DE FASE: a 190 px/s ele desce em 1,7s e sobe em
  // 1,7s, entao empilha e desempilha umas cinco vezes na fase. O jogador tem de
  // ver o ciclo mais de uma vez para a ideia virar regra.
  "StateThree": {
    "duracao": 17,
    "proximo": "",
    "movimento": { "tipo": "Mergulho", "a": 190, "b": 320 },
    "ataques": [
      { "estrategia": "CircleSpreadAttack", "projetil": "Simbolo",
        "projeteis": 18, "velocidade": 300,
        "cooldown": 1.3,
        "regras": "pilha" }
    ]
  },

  // FASE FINAL - MAQUINA DE TURING   |   gesto: A FITA
  //
  // A cabeca de leitura varre a fita, e a varredura e mais rapida e mais baixa
  // que a da fase 2: a fita final nao e lida com calma.
  //
  // DUAS CAMADAS, porque a maquina de Turing e o unico nivel da hierarquia que
  // LE E ESCREVE. A primeira escreve na passagem (a fileira que ele deixa); a
  // segunda e um leque largo que relê o que ficou, e e o que fecha o campo.
  //
  // Os cooldowns sao PRIMOS ENTRE SI de proposito (1,0 e 1,7): as duas camadas
  // nunca repetem a mesma sobreposicao, e a fase nao cai num compasso que da
  // para decorar.
  //
  // O ANEL TEM 20 SIMBOLOS, e aqui tambem nao ha "angulo": CircleSpreadAttack
  // sempre faz a volta inteira (ver a nota na fase 3). Com 20, a abertura entre
  // vizinhos e de 18 graus - uma parede com portas, que e o que um anel
  // deveria ser.
  //
  // ESTA FASE SO E VISTA POR QUEM ESTA ENTRE 40 E 59 no fim da terceira.
  // StateThree tem "proximo" vazio, entao a batalha e DECIDIDA ali: quem passou
  // termina aprovado e nunca ve a maquina de Turing. Medido - e eu tinha
  // passado duas medicoes rotulando quadros como "StateFinal" numa fase que
  // nunca rodou.
  "StateFinal": {
    "duracao": 17,
    "proximo": "StateOne",
    "movimento": { "tipo": "Varredura", "a": 330, "b": 110 },
    "ataques": [
      { "estrategia": "WaveAttack", "projetil": "Simbolo",
        "projeteis": 6, "velocidade": 300, "angulo": 20, "intervalo": 0.05,
        "cooldown": 1.0,
        "regras": "kleene" },
      { "estrategia": "CircleSpreadAttack", "projetil": "Simbolo",
        "projeteis": 20, "velocidade": 200,
        "cooldown": 1.7,
        "regras": "fita" }
    ]
  }
}
