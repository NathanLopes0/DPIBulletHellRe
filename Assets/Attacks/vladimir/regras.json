{
  // ==========================================================================
  // AS REGRAS DE PROJETIL DO VLADIMIR
  //
  // Cada conjunto aqui e uma LINGUAGEM, e a rajada que ele veste e uma palavra
  // dela. E por isso que os nomes sao os da disciplina e nao "fase1", "fase2":
  // o que define o padrao e a linguagem, e a fase so escolhe qual usar.
  //
  // ------------------------------------------------------------------------
  // "a" E "b" FAZEM COISAS DIFERENTES, E ISSO E O PONTO DO CHEFE.
  //
  // Por tres versoes seguidas eles diferiam SO NA ANIMACAO - ambar e azul, e
  // nada mais. O chefe "anunciava" numa notacao que nao previa nada, e ler a
  // palavra nao servia para coisa nenhuma: as letras eram pintura.
  //
  // A correcao sai da propria disciplina. Num automato, a funcao de transicao
  // trata os dois simbolos de formas diferentes - d(q,a) e d(q,b) nao sao a
  // mesma coisa, e e exatamente isso que faz um alfabeto ser um alfabeto. Aqui:
  //
  //     "a"  vai RETO.    Rapido de ler, rapido de desviar.
  //     "b"  PERSEGUE.    Corrige a rota com forca que decai ate zero.
  //
  // E com isso as palavras passam a dizer algo:
  //
  //     (ab)*    a cada dois tiros, um corre atras - a batida e desvia/escapa
  //     a^n b^n  CONTAR OS AMBAR DIZ QUANTOS PERSEGUIDORES VEM. A contagem
  //              deixa de ser um enfeite pedagogico e vira informacao tatica
  //
  // O TrackingBehavior decai: "fugir cedo nao resolve, fugir tarde sim". E uma
  // habilidade diferente de desviar de um tiro reto, e e dela que vem a tensao
  // de uma palavra misturada.
  // ------------------------------------------------------------------------
  //
  // UM SO PROJETIL PODE TER UM SO MOTION, e Wobble, Tracking, Accelerate e
  // SlowDown brigam entre si (Behaviors.h avisa: o Wobble reescreve a
  // velocidade todo quadro e desfaz o que os outros fizeram). Por isso nenhuma
  // regra daqui poe dois deles no mesmo simbolo - quando o "a" leva um
  // modifier, o "b" leva um motion, e nunca os dois na mesma letra.
  //
  // O "atraso" DO TRACKING NAO E CONTRA A ARMADILHA DO WOBBLE. O Tracking
  // sobrevive a um projetil dormindo: ele faz "return" quando a velocidade e
  // zero, em vez de se declarar terminado. Mas a DURACAO corre enquanto ele
  // dorme, entao numa WaveAttack - que acorda um simbolo por vez - a janela
  // pode expirar antes de o ultimo acordar. Por isso as duracoes aqui sao
  // folgadas: 2,4s cobrem o despertar inteiro mais a perseguicao.
  //
  // Os campos estao documentados em Documentacao/arquivos-de-dados.md.
  // ==========================================================================

  // (ab)* - A ESTRELA DE KLEENE.
  //
  // Alternancia pura, e agora ela se sente: um tiro reto, um perseguidor, um
  // reto, um perseguidor. A fase ensina o alfabeto nos dois sentidos - a cor
  // de cada letra E o que cada letra faz - e e sobre isso que as outras tres
  // fases contam depois.
  //
  // Quem faz a repeticao ser visivel e a ORBITA do chefe: cada volta deixa uma
  // trilha de simbolos, e a trilha alterna.
  //
  // A FORCA E A MAIS BAIXA DAS QUATRO (1,4), E E POR SER A FASE QUE ENSINA.
  // Com 1,9 o piloto parado morria AQUI, na fase 1 - nove acertos e nota 1,12
  // antes de ver a segunda. Um jogador que nunca se mexe deve mesmo reprovar,
  // mas nao antes de aprender o alfabeto: e nesta fase que ele descobre que
  // ambar vai reto e azul persegue, e as outras tres contam com isso sabido.
  "kleene": [
    { "quando": "pares",   "animacao": "A" },
    { "quando": "impares",
      "animacao": "B",
      "motion": { "tipo": "Tracking", "atraso": 0.3, "forca": 1.4, "duracao": 2.4 } }
  ],

  // a^n b^n - A LINGUAGEM QUE NENHUM AUTOMATO FINITO RECONHECE.
  //
  // Seis "a" e depois seis "b". O leque distribui os angulos EM ORDEM DE
  // INDICE, entao os seis ambar ocupam metade do arco e os seis azuis a outra.
  //
  // E AQUI A CONTAGEM VIRA INFORMACAO. Antes, saber que vinham seis "b" nao
  // mudava nada - eram iguais aos "a". Agora os seis "b" sao seis
  // perseguidores, e a metade ambar do arco e o aviso de quantos vem e de que
  // lado. Ler a palavra passa a valer o tempo de ler.
  //
  // A FORCA E MENOR QUE A DO (ab)*: 1,4 contra 1,9. Seis perseguidores de uma
  // vez com a forca da fase 1 fechariam um cerco de que nao da para sair; com
  // 1,4 eles curvam o suficiente para obrigar a andar, e pouco o bastante para
  // haver saida.
  "blocos": [
    { "indices": [0, 1, 2, 3, 4, 5],   "animacao": "A" },
    { "indices": [6, 7, 8, 9, 10, 11],
      "animacao": "B",
      "motion": { "tipo": "Tracking", "atraso": 0.3, "forca": 1.4, "duracao": 2.6 } }
  ],

  // A PILHA, VISTA DE LADO.
  //
  // O chefe mergulha enquanto empilha e sobe enquanto desempilha, entao a
  // ALTURA de cada anel e a posicao dele na pilha.
  //
  // AQUI AS DUAS LETRAS SAO AS DUAS METADES DA ESTRUTURA:
  //
  //     "a"  FICA. Freia e se pendura na altura em que nasceu - e o simbolo
  //          que esta NA pilha, e vira terreno que o jogador tem de contornar.
  //     "b"  SAI ATRAS DE VOCE. E o simbolo desempilhado, que nao fica parado
  //          esperando.
  //
  // O SlowDown so no "a" e o Tracking so no "b" tambem e o que mantem a regra
  // de um motion/modifier por simbolo: os dois no mesmo projetil se anulariam.
  "pilha": [
    { "quando": "pares",
      "animacao": "A",
      "modifiers": [ { "tipo": "SlowDown", "fator": 0.35, "atraso": 0.45 } ] },
    { "quando": "impares",
      "animacao": "B",
      "motion": { "tipo": "Tracking", "atraso": 0.5, "forca": 1.5, "duracao": 2.0 } }
  ],

  // A FITA DA MAQUINA DE TURING.
  //
  // O unico nivel da hierarquia que LE E ESCREVE, e as duas letras sao as duas
  // operacoes: o "a" e a marca deixada na fita (treme no lugar), o "b" e a
  // cabeca indo buscar o que leu.
  //
  // SEM "atraso" NO WOBBLE, de proposito: este conjunto veste um leque
  // (CircleSpread), em que todos os projeteis nascem ACORDADOS no mesmo quadro.
  // A armadilha do wobble morrer num projetil parado so existe na WaveAttack,
  // que acorda um por vez.
  "fita": [
    { "quando": "pares",
      "animacao": "A",
      "motion": { "tipo": "Wobble", "amplitude": 22, "frequencia": 1.6, "duracao": 3.0 } },
    { "quando": "impares",
      "animacao": "B",
      "motion": { "tipo": "Tracking", "atraso": 0.4, "forca": 1.6, "duracao": 2.2 } }
  ]
}
