{
  // ==========================================================================
  // AS REGRAS DE PROJETIL DO VLADIMIR
  //
  // Cada conjunto aqui e uma LINGUAGEM, e a rajada que ele veste e uma palavra
  // dela. E por isso que os nomes sao os da disciplina e nao "fase1", "fase2":
  // o que define o padrao e a linguagem, e a fase so escolhe qual usar.
  //
  // O QUE MUDOU QUANDO O CHEFE COMECOU A SE MEXER. Na primeira versao ele
  // ficava parado no centro em todas as fases, e as regras aqui faziam o
  // trabalho de espalhar os simbolos - cada letra com um Wobble para um lado,
  // para a fila nao ser uma coluna. Era maquiagem: a fase continuava
  // acontecendo num corredor estreito no meio da tela.
  //
  // Com o chefe escrevendo em movimento (ver MovementStrategies.h, as tres
  // estrategias de gesto), os simbolos ficam deitados ao longo do caminho dele
  // e o espalhamento e de verdade. Varias regras daqui simplesmente SUMIRAM, e
  // isso e o sinal de que o desenho melhorou: o efeito saiu de um truque por
  // projetil e passou a sair da ideia da fase.
  //
  // Os campos estao documentados em Documentacao/arquivos-de-dados.md.
  // ==========================================================================

  // (ab)* - A ESTRELA DE KLEENE.
  //
  // Alternancia pura: simbolo par e "a", impar e "b". E a linguagem regular
  // mais simples que ainda tem o que olhar, e serve de alfabeto visual para o
  // resto da batalha - e aqui que o jogador aprende que ambar e "a" e azul e
  // "b", sem o que nenhuma das fases seguintes se le.
  //
  // SO AS ANIMACOES, sem movimento nenhum por projetil. Quem faz a repeticao
  // ser visivel e a ORBITA do chefe: cada volta deixa um anel de simbolos, e
  // duas voltas deixam dois - a estrela de Kleene desenhada no campo. Um
  // wobble por letra aqui so embaralharia a leitura do anel.
  "kleene": [
    { "quando": "pares",   "animacao": "A" },
    { "quando": "impares", "animacao": "B" }
  ],

  // a^n b^n - A LINGUAGEM QUE NENHUM AUTOMATO FINITO RECONHECE.
  //
  // Seis "a" e depois seis "b" na mesma rajada: a palavra e lida no TEMPO, e o
  // jogador ve um trecho ambar seguido de um trecho azul do MESMO tamanho.
  // Contar o primeiro e saber o segundo - que e exatamente o que torna esta
  // linguagem nao-regular, e por que ela precisa de uma pilha.
  //
  // O QUE SEPARA OS DOIS TRECHOS AGORA E O LEQUE, e nao um wobble por letra.
  //
  // Antes, os "a" levavam um Wobble para um lado e os "b" desciam retos, e os
  // tres numeros disso (atraso, frequencia, velocidade) tinham de ser acertados
  // juntos - errei duas vezes seguidas, uma delas abrindo um corredor seguro no
  // meio da tela que deixou a fase inteira inerte.
  //
  // O leque da WaveAttack distribui os angulos EM ORDEM DE INDICE, entao os
  // seis "a" ocupam uma metade do arco e os seis "b" a outra, sozinhos. Nao ha
  // numero para acertar: a separacao e a propria ordem da rajada.
  //
  // OS INDICES COBREM A RAJADA INTEIRA, e a suite exige isso
  // (test_arquivos_de_dados: "uma regra por indice nao aponta para fora da
  // rajada"). Aqui a exigencia e um presente: ela garante que os dois blocos
  // LADRILHAM a palavra, sem simbolo sobrando nem faltando - que e a propria
  // propriedade que a fase existe para mostrar.
  //
  // O QUE FALTA, e e incremento proprio: o n CRESCER a cada ciclo. Hoje o bloco
  // tem seis fixos. Crescer pede que a regra saiba o tamanho da rajada, e
  // RegraSeAplica so recebe o indice - mudar isso mexe na assinatura do
  // configurator, que todos os chefes usam.
  "blocos": [
    { "indices": [0, 1, 2, 3, 4, 5],   "animacao": "A" },
    { "indices": [6, 7, 8, 9, 10, 11], "animacao": "B" }
  ],

  // A PILHA, VISTA DE LADO.
  //
  // O chefe mergulha enquanto empilha e sobe enquanto desempilha, entao a
  // ALTURA de cada simbolo e a posicao dele na pilha. Os simbolos saem para os
  // lados, e nao para baixo: assim cada nivel da pilha vira uma LINHA
  // horizontal no campo, e a pilha inteira fica legivel como uma pilha.
  //
  // O SlowDown e o que faz o nivel PARAR de crescer. Sem ele os simbolos saem
  // e somem pelas bordas, e o que se ve e um chuveiro; freando, eles ficam
  // pendurados perto da altura em que nasceram e o desenho se forma.
  "pilha": [
    { "quando": "pares",   "animacao": "A" },
    { "quando": "impares", "animacao": "B" },
    { "modifiers": [ { "tipo": "SlowDown", "fator": 0.35, "atraso": 0.45 } ] }
  ],

  // A FITA DA MAQUINA DE TURING.
  //
  // Na fase final o chefe e a cabeca de leitura varrendo a fita, e o que ele
  // deixa para tras sao as marcas. O Wobble aqui NAO e para espalhar - disso a
  // varredura ja cuida - e sim para a marca tremer: uma fita lida e reescrita
  // nao e uma fileira limpa de simbolos.
  //
  // SEM "atraso", de proposito. Este conjunto veste um leque (CircleSpread),
  // em que todos os projeteis nascem ACORDADOS no mesmo quadro - a armadilha
  // do wobble morrer num projetil parado so existe na WaveAttack, que acorda
  // um por vez. Pôr atraso aqui so adiaria o efeito sem motivo.
  "fita": [
    { "quando": "pares",
      "animacao": "A",
      "motion": { "tipo": "Wobble", "amplitude": 22, "frequencia": 1.6, "duracao": 3.0 } },
    { "quando": "impares",
      "animacao": "B",
      "motion": { "tipo": "Wobble", "amplitude": -22, "frequencia": 1.6, "duracao": 3.0 } }
  ]
}
