{
  // As regras de projetil do Vladimir. Cada conjunto aqui e uma linguagem, e a rajada que ele veste
  // e uma palavra dela.

  // O automato da fase 1: o mapa e as duas letras que ele le.
  "estados": [
    { "posto": "estados" }
  ],

  // A letra lida. As duas fazem o que fazem a luta inteira: o "a" vai reto, o
  // "b" persegue, com a forca e a duracao do "b" do (ab)*.
  "letra_a": [
    { "animacao": "A" }
  ],
  "letra_b": [
    { "animacao": "B",
      "motion": { "tipo": "Tracking", "atraso": 0.3, "forca": 1.4, "duracao": 2.4 } }
  ],

  // O compilador da fase 2: os nos da arvore sintatica ficam no posto "arvore", e e por la que o
  // Vladimir os acha para desfazer no fim da fase.
  "arvore": [
    { "posto": "arvore" }
  ],

  // A fita da maquina de Turing: a marca que o castor escreve, um "a" parado na casa.
  "fita": [
    { "animacao": "A", "posto": "fita" }
  ]
}
