{
  // As regras de projetil do Thiago. Uma pasta por chefe: Assets/Attacks/thiago/.

  // A varredura de uma linha ou de uma coluna: a selecao e a projecao do select, e o delete e o
  // insert da fase 2.
  "varredura": [
    { "animacao": "Linha", "escala": 2 }
  ],

  // A tabela escrita no campo: o valor de cada casa e o cabecalho de cada coluna ficam no posto
  // "tabela" (Banco.h), e o Thiago os mantem no lugar.
  "tabela": [
    { "posto": "tabela" }
  ],

  // O marcador da casa que vai ser lida, no posto "aviso": e o telegrafo de toda consulta, e o que
  // diz ao aluno de onde sair.
  "aviso": [
    { "posto": "aviso" }
  ],

  // A casa que acende (as duas operacoes juntas, e o produto cartesiano). A escala e a da
  // cobertura, e nao a do desenho.
  "clarao": [
    { "animacao": "Linha", "escala": 5.25 }
  ]
}
