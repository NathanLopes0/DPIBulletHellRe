{
  // As regras de projetil do Hugo.

  // As perguntas do Hugo perseguem o aluno por um tempo - a pergunta que ele nao responde nao vai
  // embora sozinha.
  "perguntas": [
    { "motion": { "tipo": "Tracking", "atraso": 0.4, "forca": 1.2, "duracao": 1.8 } }
  ],

  // As paginas do cronograma ficam no posto "cronograma" ate o prazo da barra vencer - e por la que
  // o Hugo as acha para apagar (Hugo::NovoCronograma).
  "cronograma": [
    { "posto": "cronograma" }
  ],

  // Os alvos do objetivo ficam no posto "objetivo": o Hugo os move, e os poderes do orientador nao
  // os apagam.
  "objetivo": [
    { "posto": "objetivo" }
  ]
}
