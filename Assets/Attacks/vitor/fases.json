{
  // ==========================================================================
  // AS FASES DO VITOR (INF 310 - Programacao Concorrente e Distribuida)
  //
  // A MATERIA E "VARIAS COISAS AO MESMO TEMPO", e a batalha e construida para
  // chegar nisso - em dois corpos, na fase 3:
  //
  //   StateOne    SEMAFOROS            as threads, a secao critica e o P(s)
  //   StateTwo    EXCLUSAO MUTUA       um anel com UMA fresta, que anda embaixo
  //   StateThree  FORK                 o chefe se divide; um corpo faz cada uma
  //   StateFinal  JOIN                 os dois voltam a ser um, fazendo as duas
  //
  // O MOVIMENTO E O ATAQUE, como no Vladimir - ver MovementStrategies.h.
  // ==========================================================================

  // FASE 1 - OS SEMAFOROS   |   gesto: AO LADO DA PORTA
  //
  // A sincronizacao, o comeco da ementa (Semaforo.h). Cada THREAD e uma
  // coluna - o nome dela no alto, na cor dela - e as instrucoes descem ate a
  // SECAO CRITICA, a faixa dourada no meio do campo, com o codigo dela no
  // canto. Antes de entrar toda thread faz P(s): sem permissao ela BLOQUEIA,
  // e as instrucoes param na borda e se empilham - a fila do P(s), ate seis;
  // cheia, a thread para de mandar. O V(s) de quem sai acorda a primeira da
  // fila, e a pilha dela desce de uma vez, em leque.
  //
  // O PLACAR DIZ s E A FILA ("s = 0 · fila: T4 T1 T5"): quem le a fila sabe
  // de que coluna vem a proxima rajada. As colunas nascem com uma EM CIMA DO
  // ALUNO, e ela chega entre as tres primeiras da fila - parado, ele nao fica
  // entre duas colunas nem espera a rodada inteira. Quatro rodadas de 4,9 s:
  //
  //   mutex            s = 1, uma de cada vez, 0,65 s cada, na ordem
  //   semaforo         s = 2, duas de cada vez, 1 s cada
  //   espera ocupada   as bloqueadas GIRAM na porta - o while gastando
  //                    processador -, entra quem ganhar o test-and-set (nao
  //                    a primeira), e o giro estoura num anel ao entrar
  //   corrida          sem trava: todas entram juntas, cada instrucao sai da
  //                    faixa torta (elas se intercalam), e o placar mostra o
  //                    saldo errado - 1 em vez de 5, a atualizacao perdida
  //
  // O PROFESSOR fica AO LADO da coluna que ele vai acordar (Conduzido), entre
  // ela e a vizinha: embaixo dele nao desce coluna nenhuma, mas quando ele
  // acorda a do lado o leque abre para cima de quem o seguia.
  //
  // AS CORRENTES CONTINUAM, as mesmas de antes (duas a cada 4,4 s, regra
  // "correntes"): o aluno preso anda a 45% e, pior, esta bloqueado em P(s) -
  // a coluna em cima dele FURA A FILA e e a proxima a entrar, e a rajada que
  // sai com ele preso persegue (Vitor.h, kForcaDaPerseguicao).
  //
  // A INSTRUCAO E DE GATILHO: o professor diz onde ela nasce e com a cara de
  // qual thread; a velocidade e a de Semaforo.h (um teste confere), e quem
  // para, empilha e solta e ele.
  "StateOne": {
    "duracao": 20,
    "proximo": "StateTwo",
    "anuncio": "semáforos",
    "movimento": { "tipo": "Conduzido", "a": 520 },
    "ataques": [
      { "gatilho": "instrucao", "estrategia": "WaveAttack", "projetil": "Instrucao",
        "projeteis": 1, "velocidade": 200, "angulo": 0, "anguloCentral": 90, "intervalo": 0 },

      // AS CORRENTES: duas a cada 4,4s.
      //
      // RARAS DE PROPOSITO: com forca 6 a corrente quase nao erra (ver
      // regras.json), entao vindo junto com toda rajada o aluno nunca estaria
      // solto. Vindo de vez em quando, cada uma e um EVENTO: da para ver
      // chegando, decidir para que lado correr, e errar.
      //
      // O leque de 20 graus so separa as duas na saida; quem decide para onde
      // elas vao e o Tracking, nao o angulo.
      { "estrategia": "WaveAttack", "projetil": "Corrente",
        "projeteis": 2, "velocidade": 260, "angulo": 20, "intervalo": 0.18,
        "cooldown": 4.4,
        "regras": "correntes" }
    ]
  },

  // FASE 2 - EXCLUSAO MUTUA   |   gesto: A ORBITA LENTA
  //
  // Um anel de 60 travas com UMA fresta de 30 graus ("angulo": 330 e o leque;
  // o que sobra da volta e a abertura). As travas freiam e ficam: a parede nao
  // passa sozinha, e atravessar e a unica saida.
  //
  // A FRESTA ANDA, SEMPRE PELA METADE DE BAIXO: de 60 a 120 graus, 37 por
  // rajada, e quem a move e Vitor::CustomizeAttackParams - para onde ela aponta
  // depende do anel anterior, e este arquivo nao tem memoria. Por isso NAO HA
  // "anguloCentral" aqui: o C++ escreve por cima, e o campo seria texto morto.
  //
  // SAO 60 TRAVAS PORQUE A FRESTA TEM DE SER O UNICO JEITO DE PASSAR. Com 24 o
  // espacamento no raio em que o jogador encontra o anel (uns 390px) dava 88
  // pixels contra um sprite de 37, e atravessar a parede em qualquer ponto era
  // trivial. Com 60 num leque de 330 sao uns 38px. Medi com 66, que volta aos
  // 34px de antes, e os tres pilotos terminaram com os mesmos acertos: ficou 60.
  //
  // A FRESTA ANDAR TROCOU A FASE DE LUGAR. Fixa embaixo, o corredor saia de
  // baixo do chefe e a fase era "fique no corredor". Agora cada porta esta num
  // x diferente, ate uns 320px para o lado, e a fase e TROCAR DE PORTA. A porta
  // em si e larga - pelo menos uns 180px na faixa do jogador, conforme a altura
  // do chefe. O dificil e o caminho: as travas andam a 54px/s depois de frear,
  // cada anel nasce de outro ponto da orbita, e a parede do anel anterior ainda
  // esta cruzando a faixa entre uma porta e a outra. No par de 90 e 67 graus a
  // janela para mudar de porta sem encostar foi de uns 1,1s.
  //
  // MEDIDO SO COM A FRESTA MUDANDO: o piloto que persegue tomava 1 acerto
  // nesta fase e passou a 5, e um que corre direto para a porta seguinte toma
  // 4. Um piloto que so da o passo quando o lugar do passo esta livre de
  // parede toma 1, o mesmo de antes. A fase continua passavel; ela cobra
  // ESPERAR a parede anterior passar, e castiga quem nao espera. (Esses dois
  // pilotos foram feitos para esta medicao e nao estao em medir-dificuldade.sh:
  // eles leem onde cada anel nasceu, e so o Vitor sabe disso.)
  //
  // O LEQUE E UMA WaveAttack, E NAO UM CircleSpread, por um motivo medido na
  // fase 3 do Vladimir: CircleSpreadAttack ignora "angulo" e "anguloCentral" -
  // ela sempre faz a volta inteira a partir do zero. Sem controle do angulo nao
  // ha fresta, e sem fresta nao ha secao critica. A WaveAttack respeita os dois.
  //
  // "intervalo": 0 porque o anel tem de nascer INTEIRO. Com os projeteis
  // acordando um a um a parede apareceria aos pedacos e a fresta nao seria
  // legivel enquanto isso.
  //
  // A ORBITA E PEQUENA E LENTA (raio 110, 0,08 volta/s): o anel precisa de um
  // centro para ser lido como anel, mas um chefe completamente parado deixa a
  // tela morta - e a licao da primeira versao do Vladimir.
  //
  // E HA NUVENS EM CIMA DELE: o Vitor tambem da Redes, e esta e a computacao
  // em nuvem. Aos 0,6 s ele forma duas (gatilho "nuvens", regra "nuvens"),
  // presas a ele uma de cada lado, e elas trabalham no ciclo de Nuvem.h:
  // PROCESSAM por 2,4 s - as luzinhas acendem e o placar diz "processando" -
  // e no fim chovem tres PACOTES cada, retos para baixo (gatilho "chover").
  // O processamento e o aviso de que vai chover.
  //
  // A CHUVA CAI DOS LADOS DO CHEFE, e nao embaixo dele: quem passa pela porta
  // do anel - que sai de baixo dele - e quem a chuva encontra. Medido na fase,
  // ela so acertou o piloto que persegue, 3 vezes (ele leva 5, e levava 2); o
  // parado e o que vai e vem tomaram exatamente os acertos de antes. E a
  // sequencia de portas e a mesma de antes: o disparo das nuvens nao empurra a
  // fresta (Vitor::DispararNuvem).
  "StateTwo": {
    "duracao": 20,
    "proximo": "StateThree",
    "anuncio": "exclusão mútua",
    "movimento": { "tipo": "Orbitar", "a": 110, "b": 0.08 },
    "ataques": [
      { "estrategia": "WaveAttack", "projetil": "Trava",
        "projeteis": 60, "velocidade": 300, "angulo": 330,
        "intervalo": 0,
        "cooldown": 2.6,
        "regras": "secao_critica" },
      { "gatilho": "nuvens", "estrategia": "WaveAttack", "projetil": "Nuvem",
        "projeteis": 2, "velocidade": 150, "angulo": 90, "intervalo": 0,
        "regras": "nuvens" },
      { "gatilho": "chover", "estrategia": "PontosAttack", "projetil": "Pacote",
        "projeteis": 3, "velocidade": 240, "angulo": 36, "anguloCentral": 90,
        "pontos": { "posto": "nuvens" } }
    ]
  },

  // FASE 3 - FORK   |   gesto: A VARREDURA, EM DOIS CORPOS
  //
  // O CHEFE SE DIVIDE EM DOIS. Um corpo faz as tarefas em paralelo e o outro
  // o anel da fase 2, ao mesmo tempo - que e o que a materia trata, e o que
  // uma batalha que faz uma coisa de cada vez nao consegue dizer.
  //
  // QUALQUER UM DOS DOIS TOMA DANO. As regras de colisao percorrem
  // Battle::Corpos(), e acertar um ou outro paga a mesma barra. Nao ha "o
  // verdadeiro" e "a copia" - fork nao faz copia, faz dois.
  //
  // O CLONE USA OS ATAQUES DA FASE 2 ("ataquesDe"), em vez de repeti-los: duas
  // copias divergem no dia em que alguem ajusta uma. Ele tambem herda o
  // MOVIMENTO da fase que empresta - entao orbita devagar, como na fase 2,
  // enquanto o original varre. O original tem a lista dele: as tarefas eram a
  // fase 1, que virou os semaforos, e moram aqui agora.
  //
  // O SEGUNDO CORPO NASCE ESPELHADO em relacao ao original (Battle::DividirChefe):
  // dois corpos no mesmo pixel seriam um so para quem olha.
  //
  // E ELE SE DIVIDE PELA NUVEM. As duas nuvens da fase 2 se juntam numa so em
  // cima dele, ele entra nela, ela processa o fork (o placar diz "fork()") e,
  // ao abrir, saem dois: o original fica onde estava e o outro anda ate o
  // espelho - 1,6 s ao todo (Nuvem::Fork). Nesse tempo nenhum dos dois ataca
  // nem anda sozinho, mas os dois continuam levando tiro: o fork nao e um
  // intervalo. Quem comeca direto nesta fase, sem nuvem, se divide como antes.
  "StateThree": {
    "duracao": 20,
    "proximo": "",
    "anuncio": "fork · dois processos",
    "movimento": { "tipo": "Varredura", "a": 190, "b": 150 },

    // AS TAREFAS EM PARALELO, que eram a fase 1, com os numeros de la: uma
    // fila curta de tarefas a cada 0,8 s com o chefe varrendo, e o que se ve
    // sao varias FAIXAS descendo ao mesmo tempo. O intervalo de 0,13 deixa as
    // tarefas a 39 px uma da outra - unidades contaveis, e nao uma barra.
    "ataques": [
      { "estrategia": "WaveAttack", "projetil": "Tarefa",
        "projeteis": 6, "velocidade": 300, "angulo": 0, "intervalo": 0.13,
        "cooldown": 0.8,
        "regras": "paralelo" },
      { "estrategia": "WaveAttack", "projetil": "Corrente",
        "projeteis": 2, "velocidade": 260, "angulo": 20, "intervalo": 0.18,
        "cooldown": 4.4,
        "regras": "correntes" }
    ],
    "clone": { "ataquesDe": "StateTwo" }
  },

  // FASE FINAL - JOIN
  //
  // Os dois fluxos voltam a ser um, e agora as tarefas PERSEGUEM: a parede
  // parada e o perseguidor movel ao mesmo tempo, que e a soma das duas
  // primeiras fases com juros.
  //
  // So e vista por quem esta entre 40 e 59 no fim da terceira - StateThree tem
  // "proximo" vazio, entao a batalha e decidida ali (medido no Vladimir).
  "StateFinal": {
    "duracao": 20,
    "proximo": "StateOne",
    "movimento": { "tipo": "Varredura", "a": 300, "b": 120 },
    "ataques": [
      { "estrategia": "WaveAttack", "projetil": "Tarefa",
        "projeteis": 5, "velocidade": 320, "angulo": 25, "intervalo": 0.04,
        "cooldown": 1.0,
        "regras": "tarefas_famintas" },
      { "estrategia": "WaveAttack", "projetil": "Trava",
        "projeteis": 52, "velocidade": 300, "angulo": 300, "anguloCentral": 270,
        "intervalo": 0,
        "cooldown": 2.9,
        "regras": "secao_critica" }
    ]
  }
}
