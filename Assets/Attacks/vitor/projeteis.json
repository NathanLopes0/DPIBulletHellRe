{
  // ==========================================================================
  // OS PROJETEIS DO VITOR (INF 310 - Programacao Concorrente e Distribuida)
  //
  // DOIS TIPOS, E ELES FAZEM COISAS DIFERENTES. Esta e a licao que o Vladimir
  // custou tres versoes a aprender: dois projeteis que diferem so na cor sao
  // pintura, e o jogador nao tem por que olhar para a diferenca.
  //
  //   Tarefa   ATRAVESSA. Trabalho correndo: rapido, reto, passa e vai embora.
  //   Trava    FICA. Recurso retido: freia quase ate parar e ocupa espaco, e o
  //            jogador tem de CONTORNAR em vez de esperar passar.
  //
  // Sao dois tipos e nao duas animacoes de um (como no Vladimir) porque aqui
  // sao duas COISAS, e nao duas letras do mesmo alfabeto - e porque escala e
  // dimensao de colisor sao por tipo, e a trava precisa ocupar mais espaco do
  // que a tarefa para a parede dela significar alguma coisa.
  //
  // OS DOIS DIVIDEM A MESMA FOLHA de sprite, cada um com os quadros dele.
  // Arte PROVISORIA de Ferramentas/gerar_vitor.py.
  // ==========================================================================
  "Tarefa": {
    "sprite": "Teachers/Projectiles/DPIBHVitorTarefa.png",
    "dados":  "Teachers/Projectiles/DPIBHVitorTarefa.json",
    "animacoes": {
      "Correndo": [0, 1, 2, 3]
    },
    "animacaoInicial": "Correndo",
    "ordemDeDesenho": 90
  },

  // A PIADA DE "CONCORRENTES": programacao CONCORRENTE, e o chefe atira
  // CORRENTES. E a unica piada do jogo que tambem e uma mecanica.
  //
  // E O PRIMEIRO PROJETIL DO JOGO QUE NAO COBRA NOTA PARA VALER. Ele cobra
  // 15% da perda normal - uns 0,9 ponto - e em troca PRENDE: 3,5 segundos a
  // 45% da velocidade. A troca e o ponto: se a corrente custasse os 6 pontos
  // de um tiro qualquer, seria um tiro qualquer que por acaso tambem prende, e
  // o jogador leria "tomei dano" em vez de "fiquei preso".
  //
  // ELA CONTA COMO ACERTO SOFRIDO, mesmo cobrando pouco - vale para o direito
  // a nota cheia e para a fase limpa. Ser acorrentado nao e de graca; e so
  // barato em nota.
  //
  // A ARTE NAO E UMA TERCEIRA COR VIVA. A Tarefa e verde e a Trava e vermelha
  // porque as duas falam de nota; a corrente e FERRO, e fala de peso. O aluno
  // preso ganha um tom da mesma familia (ver Player::UpdateCorrente), entao a
  // causa e o efeito se parecem.
  "Corrente": {
    "sprite": "Teachers/Projectiles/DPIBHVitorTarefa.png",
    "dados":  "Teachers/Projectiles/DPIBHVitorTarefa.json",
    "animacoes": {
      "Arrastando": [8, 9, 10, 11]
    },
    "animacaoInicial": "Arrastando",
    "ordemDeDesenho": 92,

    "acorrenta": {
      "segundos": 3.5,
      "fatorDeVelocidade": 0.45,
      "multiplicadorDaPerda": 0.15
    }
  },

  "Trava": {
    "sprite": "Teachers/Projectiles/DPIBHVitorTarefa.png",
    "dados":  "Teachers/Projectiles/DPIBHVitorTarefa.json",
    "animacoes": {
      "Retida": [4, 5, 6, 7]
    },
    "animacaoInicial": "Retida",
    "ordemDeDesenho": 88,

    // MAIOR QUE A TAREFA, e de proposito: a trava e um obstaculo, e um
    // obstaculo que o jogador quase nao ve nao e obstaculo. O colisor
    // acompanha a escala.
    "escala": 1.15
  },

  // AS NUVENS DA FASE 2: a computacao em nuvem, em cima do professor. Ociosa
  // ela balanca; processando, as luzinhas acendem em fila (quem troca a cara e
  // Vitor::AtualizarNuvens). Ficam acima dele, fora do caminho do tiro.
  "Nuvem": {
    "sprite": "Teachers/Projectiles/DPIBHVitorTarefa.png",
    "dados":  "Teachers/Projectiles/DPIBHVitorTarefa.json",
    "animacoes": {
      "Ociosa":      [12, 13, 14, 15],
      "Processando": [16, 17, 18, 19]
    },
    "animacaoInicial": "Ociosa",
    "ordemDeDesenho": 87,
    "escala": 2.2
  },

  // O PACOTE: o que a nuvem manda quando acaba de processar. O corpo do
  // pacote tem 16px num quadro de 32, e o colisor e o dele.
  "Pacote": {
    "sprite": "Teachers/Projectiles/DPIBHVitorTarefa.png",
    "dados":  "Teachers/Projectiles/DPIBHVitorTarefa.json",
    "animacoes": {
      "Piscando": [20, 21, 22, 23]
    },
    "animacaoInicial": "Piscando",
    "ordemDeDesenho": 91,
    "escala": 1.2,
    "colisorDivisor": 4
  }
}
