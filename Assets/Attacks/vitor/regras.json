{
  // ==========================================================================
  // AS REGRAS DE PROJETIL DO VITOR
  //
  // Cada conjunto veste uma ideia da materia, e os dois tipos de projetil
  // (Tarefa e Trava) existem justamente para as regras terem o que diferenciar.
  // Ver a nota em projeteis.json: dois projeteis que diferem so na cor sao
  // pintura.
  // ==========================================================================

  // FASE 1 - TAREFAS EM PARALELO.
  //
  // Uma fila de tarefas descendo. O chefe varre enquanto dispara, entao cada
  // rajada nasce num x diferente e o que se ve sao VARIAS FAIXAS descendo ao
  // mesmo tempo - que e o desenho de threads correndo em paralelo.
  //
  // Sem motion nenhum: tarefa e trabalho que atravessa, e trabalho que
  // atravessa vai reto. A fase e sobre passar ENTRE as faixas.
  "paralelo": [
    { "animacao": "Correndo" }
  ],

  // FASE 1 - AS CORRENTES.
  //
  // PERSEGUEM COM MAIS FORCA E POR MAIS TEMPO que todo outro Tracking do jogo:
  // os outros corrigem a rota e desistem (forca 1,4 a 1,6 por uns dois
  // segundos), porque la o perseguidor e tempero. Aqui ele e o ataque.
  //
  // 1,9 POR 2,6s, E NAO 2,6 POR 3,2s. Comecei com os numeros maiores e medi: o
  // piloto que persegue tomava 24 acertos e reprovava com 16,6, contra os 12
  // do Vladimir no mesmo arnes. O motivo e um circulo vicioso - a corrente
  // acerta, o aluno fica a 45% da velocidade, e a proxima acha um alvo que mal
  // se mexe. Um efeito que atrapalha precisa ser mais FACIL de evitar do que
  // um que so tira nota, justamente porque ele se realimenta. Com 1,9 por
  // 2,6s: 14 acertos, nota 62,4, aprovado.
  //
  // Sao DUAS a cada 3,2 segundos, contra seis tarefas a cada 0,8. Da para ver
  // vindo, e da para fugir se comecar a fugir cedo.
  //
  // O "atraso" de 0,2 deixa a corrente SAIR antes de comecar a virar. Sem ele
  // ela curva colada no chefe, e o jogador perde a informacao mais util que
  // tem: de que lado ela vem.
  "correntes": [
    { "animacao": "Arrastando",
      "motion": { "tipo": "Tracking", "atraso": 0.2, "forca": 1.9, "duracao": 2.6 } }
  ],

  // FASE 2 - EXCLUSAO MUTUA: o anel e a trava, e a fresta e a secao critica.
  //
  // O leque cobre 300 graus, entao sobram 60 de abertura - UM caminho, e so
  // um. As travas freiam quase ate parar e ficam penduradas: o anel vira uma
  // PAREDE de verdade, que nao adianta esperar passar.
  //
  // QUEM GIRA A FRESTA E O C++ (Vitor::CustomizeAttackParams), e e a unica
  // coisa deste chefe que dados nao dariam conta: "para onde a abertura aponta
  // DESTA vez" depende do disparo anterior, e fases.json nao tem memoria.
  //
  // O FREIO E FORTE (0,18) DE PROPOSITO. Com um freio leve o anel continua se
  // expandindo e a fresta passa rapido demais para ser usada; freando quase
  // ate zero, a parede fica de pe e o jogador tem tempo de achar a abertura e
  // atravessar - que e o gesto que a fase quer cobrar.
  //
  // MAS O FREIO SO ENTRA EM 1,0s, E NAO EM 0,55s, E ISSO E UMA CORRECAO.
  //
  // Com 0,55 as travas voavam 143px antes de frear e paravam a uns 240px do
  // chefe. O centro do anel voa 440px ACIMA da faixa em que o jogador vive,
  // entao o anel simplesmente NAO CHEGAVA NELE: a fase 2 inteira era cenario
  // para quem ficasse embaixo. Medido com o piloto parado - um acerto em
  // dezessete segundos, e a nota SUBINDO 33 pontos no caminho, porque ele
  // passava a fase fuzilando o chefe sem risco nenhum.
  //
  // Com 1,0s a 300 px/s elas chegam a uns 390px e o fundo do anel alcanca a
  // faixa de baixo. E por isso o anel tambem passou de 16 para 24 travas: num
  // raio maior, 16 ficam a 140 pixels uma da outra e a "parede" vira uma cerca
  // com buracos de quatro sprites de largura.
  "secao_critica": [
    { "animacao": "Retida",
      "modifiers": [ { "tipo": "SlowDown", "fator": 0.18, "atraso": 1.00 } ] }
  ],

  // As tarefas da fase final, que correm ENTRE as travas ja postas.
  //
  // Elas perseguem de leve: sozinhas seriam faceis demais no meio de uma
  // parede parada, e o que faz a fase final ser final e ter de desviar de algo
  // que se mexe enquanto se procura a fresta de algo que nao se mexe.
  "tarefas_famintas": [
    { "animacao": "Correndo",
      "motion": { "tipo": "Tracking", "atraso": 0.3, "forca": 1.5, "duracao": 2.2 } }
  ]
}
