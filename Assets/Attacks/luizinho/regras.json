{
  // ==========================================================================
  // AS REGRAS DE PROJETIL DO LUIZINHO
  //
  // Um conjunto por assunto da ementa. Os campos estao documentados em
  // Documentacao/arquivos-de-dados.md.
  // ==========================================================================

  // AMARRACAO ESTATICA: a letra de pedra sai reta. Para onde ela vai foi
  // decidido no disparo (Luizinho::CustomizeAttackParams mira o leque no
  // aluno), e dali nao muda mais.
  "estatica": [
    { "animacao": "Estatica" }
  ],

  // AMARRACAO DINAMICA: a tabuinha sai em branco, e quando a corda estica ela
  // ganha a letra - a amarracao acontecendo na frente do aluno. Dali ela gira
  // em volta do professor, vai junto para onde ele for, e quando a amarracao
  // acaba sai pela tangente.
  //
  // DUAS RODAS, EM SENTIDOS CONTRARIOS E DE RAIOS DIFERENTES. Com uma roda so,
  // girando no horario, toda letra solta do lado direito dele cai reta para
  // baixo a uma corda de distancia, e a coluna embaixo do professor ficava
  // limpa: medido, das 14 letras que acertaram os tres pilotos na fase, 13
  // eram de pedra. A contraria poe a queda do outro lado, e o raio diferente
  // deixa as duas rodas legiveis como duas, em vez de um bolo de letras que se
  // cruzam.
  "dinamica": [
    { "animacao": "Livre",
      "motion": { "tipo": "Amarrar", "comprimento": 120, "duracao": 2.4,
                  "sentido": "horario", "escreve": "Ligada" } }
  ],
  "dinamica_contraria": [
    { "animacao": "Livre",
      "motion": { "tipo": "Amarrar", "comprimento": 170, "duracao": 2.4,
                  "sentido": "antihorario", "escreve": "Ligada" } }
  ],

  // ENCAPSULAMENTO: a casca. Todas as letras de dentro nascem com a cara da
  // capsa, empilhadas, e a pilha inteira se le como uma capsula so; a
  // CapsulaAttack troca a cara de cada uma quando ela abre, e devolve o
  // tamanho de fabrica - a casca e maior que o que tem dentro.
  "capsula": [
    { "animacao": "Capsula", "escala": 1.5 }
  ],

  // MEMORIA: o bloco alocado para e fica - quem o tira do campo e o coletor
  // (Luizinho), e nao a borda da tela. As duas distancias, nas posicoes pares
  // e impares da rajada, espalham a memoria em duas faixas em vez de uma so.
  "blocos": [
    { "quando": "pares", "animacao": "Alocado",
      "modifiers": [ { "tipo": "SlowDown", "atraso": 0.8, "fator": 0.0 } ] },
    { "quando": "impares", "animacao": "Alocado",
      "modifiers": [ { "tipo": "SlowDown", "atraso": 1.4, "fator": 0.0 } ] }
  ]

  // A SERPENTE DA FINAL NAO TEM REGRA, de proposito: quem a move sao as duas
  // Motions que a SerpenteAttack poe em cada gomo, e uma "motion" aqui as
  // SUBSTITUIRIA - a regra roda depois da estrategia.
}
