  // o Escopo::kRaioDaGota com que a regiao e coberta (um teste confere).
  "Gota": {
    "sprite": "Teachers/Projectiles/DPIBHLuizinhoGotas.png",
    "dados":  "Teachers/Projectiles/DPIBHLuizinhoGotas.json",
    "animacoes": {
      "AvisoX": [0],
      "X":      [1],
      "AvisoY": [2],
      "Y":      [3]
    },
    "animacaoInicial": "AvisoX",
    "ordemDeDesenho": 88
  },

  // OS VALORES DA FASE 2 (Coercao.h): o numero num chip azul, o texto num
