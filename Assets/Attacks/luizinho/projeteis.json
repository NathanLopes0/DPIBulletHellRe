      "Numero18": [18], "Numero19": [19], "Numero20": [20], "Texto0": [21], "Texto1": [22], "Texto2": [23],
      "Texto3": [24], "Texto4": [25], "Texto5": [26], "Texto6": [27], "Texto7": [28], "Texto8": [29],
      "Texto9": [30], "Letra0": [31], "Letra1": [32], "Letra2": [33], "Letra3": [34], "Letra4": [35],
