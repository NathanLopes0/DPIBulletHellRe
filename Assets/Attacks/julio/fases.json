{
  // ==========================================================================
  // AS FASES DO JULIO
  //
  // UMA PASTA POR CHEFE: Assets/Attacks/julio/. A fabrica dele pede as fases
  // pelo nome da pasta:
  //     ConfigurarFasesDeArquivo(boss, fsm, "julio")
  //
  // OS NOMES DE FASE NAO SAO LIVRES. A maquina de estados procura os estados
  // por TEXTO, e so estes quatro existem:
  //     StateOne, StateTwo, StateThree, StateFinal
  // Um nome inventado e recusado na leitura, porque a fase existiria no arquivo
  // sem nunca ser alcancada.
  //
  // StateFinal E OBRIGATORIO, mesmo num chefe de tres fases. Se a nota ficar
  // entre 40 e 59 ao fim da terceira fase, a FSM vai para StateFinal; sem o
  // estado, ela apenas registra um erro no log e O CHEFE CONGELA - sem travar o
  // jogo e sem avisar em tela. Isso ja custou depuracao uma vez.
  //
  // "proximo" vazio ou ausente significa "a batalha e decidida ao fim desta
  // fase" (ver BossAttackState), e nao "fim do arquivo".
  //
  // OS CAMPOS de um ataque e do movimento estao documentados em
  // Documentacao/arquivos-de-dados.md. Dois merecem lembrete aqui:
  //
  //   CAMPO OMITIDO = PADRAO DO MOTOR. A ponte so escreve no AttackParams o que
  //   este arquivo disser; nao ha valor "zero por omissao" nenhum.
  //
  //   anguloCentral pode ser SOBRESCRITO pelo chefe em tempo de execucao, no
  //   CustomizeAttackParams dele - e o unico pedaco do balanceamento que ainda
  //   vive em C++. Onde isso acontece esta anotado na fase.
  // ==========================================================================
// ==========================================================================
// JULIO - INF 420, Inteligencia Artificial (fabrica de projeteis: "Dados")
//
// O PROFESSOR DE IA, E A AREA DELE SAO OS MODELOS DE LINGUAGEM. A batalha vai
// virando um LLM, uma fase por commit: a fase 1 ja e a geracao de tokens com
// temperatura, a fase 2 os agentes que ele convoca, a fase 3 os guardrails
// que o protegem; a repescagem ainda e a de antes - o modelo entra em loop.
//
// Julio SOBRESCREVE anguloCentral nas QUATRO fases (Julio.cpp), e cada uma de
// um jeito diferente:
//   StateOne    mira exata no aluno - quem desvia e a temperatura dos tokens
//   StateTwo    nao mexe: os agentes saem no leque daqui, e cada um mira por si
//   StateThree  mira em onde o aluno ESTARA (GetPredictedPlayerDirection)
//   StateFinal  volta a atirar para baixo, 90 graus fixos
// Por isso as fases 1, 3 e final nao escrevem anguloCentral aqui: nao teria
// efeito. (O anel de guardrails e uma CircleSpreadAttack, que nem o le.)
//
// A animacao dos DADOS tambem e decidida por fase em Julio::OnProjectilesCreated,
// que roda DEPOIS do configurator - "Coleta", "Perseguicao" e "Previsao". Uma
// animacao escrita nas regras destas fases seria sobrescrita por ela. Os
// tokens nao passam por la: a cara deles e a da frase.
// ==========================================================================

  // FASE 1 - OS TOKENS   |   "o modelo te prediz"
  //
  // O PROFESSOR E UM MODELO DE LINGUAGEM GERANDO TEXTO. A cada 2 s ele solta
  // uma FRASE de sete tokens (TokenAttack), um saindo depois do outro: "o mo
  // de lo te pre diz" - o modelo te prediz -, cada token num chip
  // (Ferramentas/gerar_julio.py). A frase sai mirada onde o aluno estava.
  //
  // CADA TOKEN E SORTEADO COM TEMPERATURA (Temperatura.h): os candidatos sao
  // nove angulos em volta da mira, e o mais provavel e o tiro certo. O placar
  // diz a temperatura de cada etapa:
  //
  //   Fria    0,2  sai sempre o mais provavel: a frase chega inteira, em fila
  //   Morna   0,8  a frase se abre num leque
  //   Quente  1,6  qualquer angulo sai - a frase vira alucinacao
  //
  // Fria, a fila inteira vem num lugar so, e um passo para o lado desvia de
  // tudo; quente, o leque pega quem desviou. Medido com um piloto que
  // ziguezagueia, virando a cada 0,6, 1,0 e 1,5 s: nas etapas morna e quente
  // ele levou 4, 2 e 3 acertos, e com a temperatura desligada - todo token
  // mirado - 1, 1 e 2. Quem nao desvia leva o mesmo nas duas: o parado, 9.
  //
  // EM FRASES, E NAO EM FLUXO. Com um token a cada 0,12 s o piloto que
  // persegue o professor - e fica embaixo dele, onde a mira cai - levava um
  // acerto toda vez que a invencibilidade acabava: 8 na fase, os tres
  // primeiros a 1,2 s um do outro. Em frases de sete a cada 2 s, ele leva 5 e
  // termina a fase com 74,8; o parado leva 9 e cai para 17,4.
  "StateOne": {
    "duracao": 17,
    "proximo": "StateTwo",
    "anuncio": "Gerando tokens",
    "etapas": [
      { "nome": "Fria",   "duracao": 5.6, "anuncio": "temperatura = 0,2" },
      { "nome": "Morna",  "duracao": 5.7, "anuncio": "temperatura = 0,8" },
      { "nome": "Quente", "duracao": 5.7, "anuncio": "temperatura = 1,6 · alucinando" }
    ],
    "movimento": { "tipo": "RandomWander", "a": 3.5, "b": 115 },
    "ataques": [
      { "etapa": "Fria", "estrategia": "TokenAttack", "projetil": "Token",
        "projeteis": 7, "velocidade": 300, "intervalo": 0.07, "cooldown": 2.0,
        "tokens": { "temperatura": 0.2, "candidatos": 9, "abertura": 120,
                    "frase": ["o", "mo", "de", "lo", "te", "pre", "diz"] } },
      { "etapa": "Morna", "estrategia": "TokenAttack", "projetil": "Token",
        "projeteis": 7, "velocidade": 300, "intervalo": 0.07, "cooldown": 2.0,
        "tokens": { "temperatura": 0.8, "candidatos": 9, "abertura": 120,
                    "frase": ["o", "mo", "de", "lo", "te", "pre", "diz"] } },
      { "etapa": "Quente", "estrategia": "TokenAttack", "projetil": "Token",
        "projeteis": 7, "velocidade": 300, "intervalo": 0.07, "cooldown": 2.0,
        "tokens": { "temperatura": 1.6, "candidatos": 9, "abertura": 120,
                    "frase": ["o", "mo", "de", "lo", "te", "pre", "diz"] } }
    ]
  },

  // FASE 2 - OS AGENTES   |   o ciclo ReAct
  //
  // O PROFESSOR CONVOCA ROBOS QUE AGEM POR ELE. A cada 6 s ele solta tres
  // agentes (regra "convocar"), que param a 260px dele - um embaixo, dois dos
  // lados - e ficam 10 s. Cada um aguenta QUATRO tiros ("resistencia"): tem de
  // ser vencido, e o tiro gasto nele nao vai para o professor.
  //
  // OS AGENTES TRABALHAM NO CICLO DE UM AGENTE DE LLM, o ReAct (ReAct.h,
  // Julio::AtualizarAgentes): PENSAM por 1 s, AGEM por 0,5 s e OBSERVAM por
  // 0,6 s, e o placar diz o passo. No Age todos mandam a ferramenta - a
  // engrenagem - ao mesmo tempo, mirada no aluno ("gatilho": "agir").
  //
  // A MIRA E ONDE O ALUNO ESTA, e nao onde ele vai estar. Prevendo, os agentes
  // erravam quem desvia: um piloto que ziguezagueia levou 0, 0 e 1 acerto na
  // fase (virando a cada 0,6, 1,0 e 1,5 s), contra 3, 5 e 3 mirando no aluno
  // de agora.
  //
  // MEDIDO NA FASE, todo acerto e de ferramenta: o piloto que persegue leva 5,
  // vence os 3 agentes que param embaixo do professor - na coluna do tiro
  // dele - e sai com 70,6; o parado leva 8; o que vai e vem passa por baixo
  // dos agentes, vence 5 e nao leva nenhum.
  "StateTwo": {
    "duracao": 17,
    "proximo": "StateThree",
    "anuncio": "Agentes",
    "movimento": { "tipo": "RandomWander", "a": 3.5, "b": 115 },
    "ataques": [
      { "estrategia": "WaveAttack", "projetil": "Agente",
        "projeteis": 3, "velocidade": 260, "angulo": 120, "intervalo": 0,
        "cooldown": 6.0,
        "regras": "convocar" },
      { "gatilho": "agir", "estrategia": "PontosAttack", "projetil": "Ferramenta",
        "projeteis": 1, "velocidade": 250,
        "pontos": { "posto": "agentes", "mirar": true } }
    ]
  },

  // FASE 3 - OS GUARDRAILS   |   gesto: A ORBITA
  //
  // O MODELO GANHA UMA CAMADA DE SEGURANCA. A cada 6 s o professor solta um
  // anel de oito GUARDRAILS (regra "guardrails"), robos-escudo amarrados a ele
  // por uma corda de 95px, girando em volta dele por 5,5 s. Cada um aguenta
  // tres tiros: o tiro que ele come nao chega ao professor, e o placar diz o
  // que um guardrail diz - "desculpe, nao posso ajudar com isso". O que cai e
  // um "jailbreak!". E o anel volta, RETREINADO, a cada 6 s; o que sobrou do
  // anterior sai pela tangente quando a corda e cortada.
  //
  // E O MODELO TE PREDIZ, agora de verdade: um token a cada 0,35 s, mirado
  // onde o aluno VAI ESTAR (Julio::CustomizeAttackParams), e a frase da fase 1
  // ("o mo de lo te pre diz") se escreve aos poucos, um token por disparo.
  //
  // A ORBITA E PARA A FASE TER COMO PASSAR. Com o professor parado no centro
  // (GoToCenter, a fase de antes) o piloto que persegue fica parado embaixo
  // dele, onde a mira prevista e a mira de agora: com o tiro de previsao da
  // fase de antes, a cada 0,25 s, ele levava um acerto a cada fim de
  // invencibilidade - 12 em 17 s - e zerava a nota. Na orbita lenta ele leva 3 na fase, todos de token,
  // e vence os 24 guardrails dos tres aneis; o parado leva 8 e zera.
  "StateThree": {
    "duracao": 17,
    "proximo": "",
    "anuncio": "Guardrails",
    "movimento": { "tipo": "Orbitar", "a": 160, "b": 0.10 },
    "ataques": [
      { "estrategia": "CircleSpreadAttack", "projetil": "Guardrail",
        "projeteis": 8, "velocidade": 160,
        "cooldown": 6.0,
        "regras": "guardrails" },
      { "estrategia": "TokenAttack", "projetil": "Token",
        "projeteis": 1, "velocidade": 300, "cooldown": 0.35,
        "tokens": { "temperatura": 0, "frase": ["o", "mo", "de", "lo", "te", "pre", "diz"] } }
    ]
  },

  // FASE FINAL - "Entrou em loop" (repescagem, nota entre 40 e 59)
  //
  // PRECISA existir mesmo o Julio sendo um chefe de 3 fases. Se a nota cair
  // nessa faixa ao fim da fase 3, a FSM tenta ir para StateFinal; sem o estado,
  // ela apenas registra o erro e o chefe TRAVA.
  //
  // Tema: o modelo travou. A piada e de graca para calouro de computacao - as
  // balas entram em LOOP antes de vir para cima de voce. Continua sendo a fase
  // mais facil da luta, que e o papel de uma repescagem.
  "StateFinal": {
    "duracao": 17,
    "proximo": "StateOne",
    "movimento": { "tipo": "RandomWander", "a": 4.5, "b": 85 },
    "ataques": [
      { "estrategia": "CircleSpreadAttack", "projetil": "Dados",
        "projeteis": 6, "velocidade": 150,
        "cooldown": 2.6,
        "regras": "final_laco" }
    ]
  }
}
