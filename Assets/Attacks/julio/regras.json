{
  // As regras de projetil do Julio. Uma pasta por chefe: Assets/Attacks/julio/.

  // Fase 2: o agente convocado nasce no posto dos agentes - de onde as ferramentas saem no Age -, e
  // quem o move e o Julio (MoverAgentes).
  "convocar": [
    { "posto": "agentes" }
  ],

  // Fase 3: os guardrails, amarrados ao professor. A corda estica a 95px e
  // o anel gira em volta dele por 5,5 s; cortada, cada um sai pela tangente.
  "guardrails": [
    { "motion": { "tipo": "Amarrar", "comprimento": 95, "duracao": 5.5, "sentido": "horario" } }
  ],

  // Fase final: um anel de 6, cada um dando uma volta antes de seguir em frente.
  "final_laco": [
    { "animacao": "e",
      "motion": { "tipo": "Path", "forma": "LacoApertado", "velocidade": 650 } }
  ]
}
