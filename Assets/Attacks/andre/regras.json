{
  // ==========================================================================
  // AS REGRAS DE PROJETIL DO ANDRE
  //
  // UMA PASTA POR CHEFE: Assets/Attacks/andre/. Cada chave e um conjunto de
  // regras, e e por esse nome que um ataque do fases.json ao lado o pede:
  //     "regras": "confete"
  //
  // UMA REGRA = uma motion (como o projetil se move), modifiers (o que muda nele
  // com o tempo), uma animacao e uma chance. Tudo opcional: regra so com
  // "animacao" existe e e legitima.
  //
  // OS CAMPOS estao documentados em Documentacao/arquivos-de-dados.md.
  // ==========================================================================
  // O CONFETE nao cai reto: balanca de um lado para o outro, como papel. A
  // faixa continua a do ramo - o balanco e de poucos graus.
  "confete": [
    { "motion": { "tipo": "Wobble", "amplitude": 18, "frequencia": 2.2, "duracao": 3.0 } }
  ]
}
