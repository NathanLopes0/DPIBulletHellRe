{
  // ==========================================================================
  // AS FASES DO ANDRE
  //
  // UMA PASTA POR CHEFE: Assets/Attacks/andre/. A fabrica dele pede as fases
  // pelo nome da pasta:
  //     ConfigurarFasesDeArquivo(boss, fsm, "andre")
  //
  // OS NOMES DE FASE NAO SAO LIVRES. A maquina de estados procura os estados
  // por TEXTO, e so estes quatro existem:
  //     StateOne, StateTwo, StateThree, StateFinal
  // Um nome inventado e recusado na leitura, porque a fase existiria no arquivo
  // sem nunca ser alcancada.
  //
  // StateFinal E OBRIGATORIO, mesmo num chefe de tres fases. Se a nota ficar
  // entre 40 e 59 ao fim da terceira fase, a FSM vai para StateFinal; sem o
  // estado, ela apenas registra um erro no log e O CHEFE CONGELA - sem travar o
  // jogo e sem avisar em tela. Isso ja custou depuracao uma vez.
  //
  // "proximo" vazio ou ausente significa "a batalha e decidida ao fim desta
  // fase" (ver BossAttackState), e nao "fim do arquivo".
  //
  // OS CAMPOS de um ataque e do movimento estao documentados em
  // Documentacao/arquivos-de-dados.md. Dois merecem lembrete aqui:
  //
  //   CAMPO OMITIDO = PADRAO DO MOTOR. A ponte so escreve no AttackParams o que
  //   este arquivo disser; nao ha valor "zero por omissao" nenhum.
  //
  //   anguloCentral pode ser SOBRESCRITO pelo chefe em tempo de execucao, no
  //   CustomizeAttackParams dele - e o unico pedaco do balanceamento que ainda
  //   vive em C++. Onde isso acontece esta anotado na fase.
  // ==========================================================================
// ==========================================================================
// ANDRE - INF 110 (Programacao 1)
//
// A PRIMEIRA MATERIA DO CURSO, um conceito de Programacao 1 por fase: o placar
// e o codigo que o professor esta rodando, e o campo e a execucao dele. Os
// BALOES DO BOCA ficam - no BOCA, cada problema resolvido vale um balao da cor
// dele.
// ==========================================================================

  // FASE 1 - O DESVIO CONDICIONAL   |   gesto: O FLUXOGRAMA
  //
  // O FLUXOGRAMA ESTA DESENHADO NO CAMPO (Condicional.h): o losango da
  // decisao embaixo do professor, e um RAMO por faixa, da esquerda para a
  // direita na ordem do codigo, com o cabecalho no alto ("if (n > 5)",
  // "else"). A cada 0,9 s sai do professor um balao com um numero; ele para no
  // losango, a condicao e avaliada com o numero DELE, e ele segue a seta do
  // ramo ate o cabecalho, onde estoura - e o confete cai pela faixa daquele
  // ramo, de cima a baixo. O aluno le o numero e a condicao e sai da faixa.
  //
  // Um comando a cada 3,33 s (seis na fase), cada um com o seu placar: if/else, o resto da
  // divisao por 2, else if (tres faixas: vale o primeiro), o switch SEM BREAK
  // (quatro faixas: o case de n estoura e cai nos de baixo, um depois do
  // outro; n sem case nao executa nada) e if (n = 0) - a ATRIBUICAO: o numero
  // do balao vira 0 no losango, e o if e sempre falso.
  //
  // Todos os ataques sao de GATILHO: quem diz onde e quando e o Andre. O
  // confete nasce no cabecalho com a velocidade daqui, a de
  // Condicional::kVelocidadeDoConfete (um teste confere), e o Andre o espalha
  // pela faixa. A VELOCIDADE DE QUEM ANDA SOZINHO E SEMPRE A DAQUI: a
  // WaveAttack a escreve no primeiro quadro do projetil, por cima do que o
  // chefe tiver escrito.
  "StateOne": {
    "duracao": 20,
    "proximo": "StateTwo",
    "anuncio": "if / else",
    "movimento": { "tipo": "Conduzido", "a": 380 },
    "ataques": [
      { "gatilho": "rotulo", "estrategia": "WaveAttack", "projetil": "Rotulo",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "balao", "estrategia": "WaveAttack", "projetil": "Balao",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "confete", "estrategia": "WaveAttack", "projetil": "Confete",
        "projeteis": 12, "velocidade": 300, "angulo": 0, "anguloCentral": 90, "intervalo": 0,
        "regras": "confete" }
    ]
  },

  // FASE 2 - A REPETICAO   |   gesto: O VETOR NO CHAO
  //
  // O CHAO E UM VETOR (Laco.h): doze casas, v[0] a v[11], uma por faixa de
  // 100 px, com o indice escrito embaixo. Cada laco anda pelo vetor com o i
  // dele - a casa da vez acende -, e 0,6 s depois sobe do chao, naquela casa,
  // um cacho de tres baloes do BOCA. O placar e o cabecalho do laco: o aluno le
  // onde comeca, ate onde vai e de quanto em quanto, e fica numa casa por onde
  // o i nao passa.
  //
  // Sete lacos, um depois do outro: o for de passo 2 ou 3, o de tras para a
  // frente, o i *= 2, o continue (o i passa por todas, as do continue acendem
  // azuis e ficam sem balao), o aninhado (uma passada por k, cada uma uma casa
  // para o lado), o <= 12 que passa do fim - "Segmentation fault (core
  // dumped)", e os bytes da memoria voam da borda - e o while (1), que sorteia
  // casas ate o juiz do BOCA matar o programa ("Time limit exceeded") e os
  // baloes dele sumirem. Os sete cabem na fase com folga, e o que sobra dela
  // recomeca a ordem.
  //
  // Todos os ataques sao de GATILHO. O cacho nasce embaixo do campo na
  // velocidade daqui, a de Laco::kVelocidadeDoCacho (um teste confere); o
  // despejo sai da borda, para dentro do campo - quem escolhe o lado e o
  // Andre.
  "StateTwo": {
    "duracao": 20,
    "proximo": "StateThree",
    "anuncio": "for / while",
    "movimento": { "tipo": "Conduzido", "a": 380 },
    "ataques": [
      { "gatilho": "indice", "estrategia": "WaveAttack", "projetil": "Indice",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "subir", "estrategia": "WaveAttack", "projetil": "Baloes",
        "projeteis": 3, "velocidade": 240, "angulo": 0, "anguloCentral": 270, "intervalo": 0 },
      { "gatilho": "core", "estrategia": "WaveAttack", "projetil": "Byte",
        "projeteis": 12, "velocidade": 280, "angulo": 90, "anguloCentral": 195, "intervalo": 0 }
    ]
  },

  // FASE 3 - AS FUNCOES   |   gesto: A CHAMADA E O RETORNO
  //
  // O PROFESSOR E O MAIN (Funcao.h): cada comando dele e uma chamada, escrita
  // no placar, e cada funcao chamada e um CARTAO no meio do campo com a
  // assinatura dela. Os argumentos sao valores que voam do professor ate o
  // cartao, e so quando chegam a funcao roda; a que devolve alguma coisa manda
  // o retorno de volta para ele, e o placar troca a chamada pelo valor
  // ("baloes(dobro(3), 11);" vira "baloes(6, 11);"). O vetor do chao da fase 2
  // continua la, e e nele que as funcoes trabalham:
  //
  //   baloes(de, ate)    um cacho de cada casa, de v[de] a v[ate] - um laco
  //                      dentro da funcao
  //   leque(n)           n ponto-e-virgulas mirados no aluno, do cartao
  //   dobro, meio        devolvem 2x e (a + b) / 2, a divisao de inteiros
  //   baloes(aluno - 1, aluno + 1)   POR VALOR: a casa do aluno e copiada na
  //                      hora da chamada e voa DELE ate a funcao - quem saiu
  //                      dali ja nao esta onde a copia diz
  //   segue(&aluno)      POR REFERENCIA: uma linha liga o cartao ao aluno, e
  //                      cada cacho sobe onde ele esta AGORA
  //
  // Todos os ataques sao de GATILHO. O cacho e o indice sao os da fase 2, com
  // as mesmas velocidades (um teste confere); o leque sai do cartao mirado no
  // aluno - quem escolhe quantos e o argumento.
  "StateThree": {
    "duracao": 20,
    "proximo": "",
    "anuncio": "funcoes",
    "movimento": { "tipo": "Conduzido", "a": 380 },
    "ataques": [
      { "gatilho": "indice", "estrategia": "WaveAttack", "projetil": "Indice",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "subir", "estrategia": "WaveAttack", "projetil": "Baloes",
        "projeteis": 3, "velocidade": 240, "angulo": 0, "anguloCentral": 270, "intervalo": 0 },
      { "gatilho": "cartao", "estrategia": "WaveAttack", "projetil": "Cartao",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "valor", "estrategia": "WaveAttack", "projetil": "Valor",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0 },
      { "gatilho": "leque", "estrategia": "WaveAttack", "projetil": "Ponto",
        "projeteis": 5, "velocidade": 320, "angulo": 50, "anguloCentral": 90, "intervalo": 0 }
    ]
  },

