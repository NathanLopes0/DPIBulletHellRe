{
  // ==========================================================================
  // OS PROJETEIS DA MARIA LUCIA (INF 221 - Engenharia de Software)
  //
  // DOIS TIPOS, E ELES FAZEM COISAS DIFERENTES - a licao que o Vladimir custou
  // tres versoes a aprender: dois projeteis que diferem so na cor sao pintura,
  // e o jogador nao tem por que olhar para a diferenca.
  //
  //   Requisito  ATRAVESSA. Pedido chegando: rapido, reto, passa e vai embora.
  //   Debito     FICA. O que voce nao resolveu: para no meio do campo e
  //              continua la segundos depois, virando terreno.
  //
  // A DIFERENCA PARA A "Trava" DO VITOR, que a primeira vista e o mesmo
  // projetil, e o motivo de existirem os dois:
  //
  //   a Trava e uma parede que se contorna AGORA, e ela reinicia a cada
  //   rajada - a fase dela e sobre achar a fresta;
  //
  //   o Debito nao esta no seu caminho agora, esta no seu caminho DEPOIS, e
  //   ele NAO reinicia - a fase dele e sobre o campo ir ficando menor.
  //
  // Por isso o Debito nao freia (SlowDown), ele PARA num ponto do caminho
  // ("pararNoPonto" em regras.json): freado ele continuaria escorregando para
  // fora da tela e a divida se pagaria sozinha, que e justamente o que divida
  // nao faz.
  //
  // OS DOIS DIVIDEM A MESMA FOLHA de sprite, cada um com os quadros dele.
  // Arte PROVISORIA de Ferramentas/gerar_maria_lucia.py.
  // ==========================================================================
  "Requisito": {
    "sprite": "Teachers/Projectiles/DPIBHMariaLuciaRequisito.png",
    "dados":  "Teachers/Projectiles/DPIBHMariaLuciaRequisito.json",
    "animacoes": {
      "Novo":   [0, 1, 2, 3],
      "Codigo": [8, 9, 10, 11]
    },
    "animacaoInicial": "Novo",
    "ordemDeDesenho": 90
  },

  "Debito": {
    "sprite": "Teachers/Projectiles/DPIBHMariaLuciaRequisito.png",
    "dados":  "Teachers/Projectiles/DPIBHMariaLuciaRequisito.json",
    "animacoes": {
      "Acumulado": [4, 5, 6, 7]
    },
    "animacaoInicial": "Acumulado",
    "ordemDeDesenho": 88,

    // MAIOR QUE O REQUISITO, e de proposito: ele passa a vida PARADO, e um
    // obstaculo parado que o jogador mal enxerga nao e obstaculo, e armadilha.
    // O colisor acompanha a escala.
    "escala": 1.2
  },

  // O BUG DOS TESTES E UM TIPO A PARTE porque tem uma propriedade de TIPO: o
  // tiro do aluno o derruba. Testar e achar bug - mas o tiro que acha um bug se
  // gasta nele e nao chega na professora.
  "Bug": {
    "sprite": "Teachers/Projectiles/DPIBHMariaLuciaRequisito.png",
    "dados":  "Teachers/Projectiles/DPIBHMariaLuciaRequisito.json",
    "animacoes": {
      "Andando": [12, 13, 14, 15]
    },
    "animacaoInicial": "Andando",
    "ordemDeDesenho": 91,
    // Sem escala, as perninhas de 2 px somem e o bug vira um ponto verde.
    "escala": 1.4,
    "derrubavel": true
  },

  // A HISTORIA DAS SPRINTS E O CURSOR QUE A ARRASTA vem do mesmo tipo: a
  // SprintAttack tira os dois da mesma fabrica, e o cursor e marcado como
  // ENFEITE no disparo - nao acerta o aluno e o tiro passa por ele. A historia
  // e derrubavel: derrubar e ENTREGAR, e o tiro que entrega uma historia nao
  // chega na professora.
  "Historia": {
    "sprite": "Teachers/Projectiles/DPIBHMariaLuciaRequisito.png",
    "dados":  "Teachers/Projectiles/DPIBHMariaLuciaRequisito.json",
    "animacoes": {
      "Historia": [24, 25, 26, 27],
      "Cursor":   [16, 17],
      "Clique":   [18, 19]
    },
    "animacaoInicial": "Historia",
    "ordemDeDesenho": 91,
    "escala": 1.3,
    "derrubavel": true
  },

  // O OBSERVADOR DO PADRAO OBSERVER (fase 3): o post-it com um olho. A
  // professora troca a cara dele a cada quadro (MariaLucia::AtualizarObserver):
  // o olho OLHA para o lado em que o aluno esta - o rastreamento do olhar, da
  // IHC - e PISCA quando o aluno notifica. Um quadro por cara, porque quem
  // anima e ela. NAO e derrubavel: a assinatura nao se cancela a tiro, se
  // evita mudando pouco de estado.
  "Observador": {
    "sprite": "Teachers/Projectiles/DPIBHMariaLuciaRequisito.png",
    "dados":  "Teachers/Projectiles/DPIBHMariaLuciaRequisito.json",
    "animacoes": {
      "OlhaEsquerda": [20],
      "OlhaFrente":   [21],
      "OlhaDireita":  [22],
      "Pisca":        [23]
    },
    "animacaoInicial": "OlhaFrente",
    "ordemDeDesenho": 89,
    "escala": 1.3
  },

  // O AVISO DO OBSERVER: o que cada olho manda quando o aluno notifica - o
  // selo vermelho de notificacao, o "algo mudou" de toda interface. A primeira
  // versao mandava um post-it, e o aviso amarelo se confundia com o olho, que
  // tambem e post-it.
  //
  // O COLISOR E O DO SELO, e nao o do quadro: o selo tem 8 px de raio num
  // quadro de 32, e com o divisor de sempre (2) o aviso acertaria a 16 px, onde
  // nao ha nada desenhado.
  "Aviso": {
    "sprite": "Teachers/Projectiles/DPIBHMariaLuciaRequisito.png",
    "dados":  "Teachers/Projectiles/DPIBHMariaLuciaRequisito.json",
    "animacoes": {
      "Notificacao": [32, 33, 34, 35]
    },
    "animacaoInicial": "Notificacao",
    "ordemDeDesenho": 92,
    "escala": 1.3,
    "colisorDivisor": 4
  },

  // A JANELA MODAL DA FASE FINAL: a janelinha com a barra de titulo, o X e o
  // OK pulsando. Fica presa a professora (regra "modal") como um dialogo
  // centrado na janela que o abriu, e e um ANTEPARO: o tiro que a acerta nao
  // chega na professora. Fecha-la custa TRES tiros - "Tem certeza?", "Sim",
  // "OK" -, e a que ninguem fecha solta e cai.
  "Dialogo": {
    "sprite": "Teachers/Projectiles/DPIBHMariaLuciaRequisito.png",
