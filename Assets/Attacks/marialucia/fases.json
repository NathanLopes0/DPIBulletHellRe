  // FASE FINAL - MANUTENCAO   |   gesto: A VARREDURA RAPIDA
  //
  // A mesma varredura da fase 3 a uma vez e meia a velocidade, e a repeticao e
  // o recado: o ciclo nao acabou, recomecou com o sistema ja velho.
  //
  // TRES CAMADAS, uma de cada fase anterior - e e por isso que esta fase existe
  // assim e nao com um ataque novo. Manter um sistema nao e enfrentar um
  // problema inedito, e enfrentar os tres que voce ja conhecia ao mesmo tempo.
  //
  //   requisitos que PERSEGUEM   (regras "manutencao")   - o pedido te acha
  //   as setas do diagrama       (regras "diagrama")     - o desenho ainda vale
  //   o debito                   (regras "divida")       - o que ficou, ficou
  //
  // OS COOLDOWNS SAO QUASE PRIMOS ENTRE SI (1,1 / 2,3 / 3,1): as tres camadas
  // nunca repetem a mesma sobreposicao, e a fase nao cai num compasso que da
  // para decorar. Isso importa mais nesta chefe do que nas outras, porque a
  // batalha dela nao tem sorteio nenhum - ver a nota do topo.
  //
  // O debito vem em leva de TRES, e nao de quatro: ele ja chega num campo
  // ocupado, e nao precisa de volume para pesar.
  //
  // SO E VISTA POR QUEM ESTA ENTRE 40 E 59 no fim da terceira.
  "StateFinal": {
    "duracao": 17,
    "proximo": "StateOne",
    "movimento": { "tipo": "Varredura", "a": 300, "b": 120 },
    "ataques": [
