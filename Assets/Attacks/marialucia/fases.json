      { "nome": "Testes",        "duracao": 3.4, "anuncio": "4 · Testes" },
      { "nome": "Manutencao",    "duracao": 3.4, "anuncio": "5 · Manutenção" }
    ],
    "movimento": { "tipo": "Escada", "a": 3.4, "b": 5 },
    "ataques": [
