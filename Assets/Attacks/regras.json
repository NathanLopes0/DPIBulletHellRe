{
  // ==========================================================================
  // REGRAS DE PROJETIL
  //
  // Cada conjunto e uma lista de regras aplicadas a CADA projetil de uma
  // rajada, na ordem em que aparecem. Um ataque de fases.json aponta para um
  // conjunto pelo nome: "regras": "ricardo_fase2".
  //
  // A QUEM A REGRA SE APLICA (escolha no maximo uma forma):
  //   nada           -> a todos os projeteis da rajada
  //   "quando"       -> "sempre", "pares" (indices 0,2,4...) ou "impares"
  //   "indices": []  -> posicoes especificas dentro da rajada
  //   "chance": 0.2  -> sorteio por projetil
  //
  // O QUE A REGRA FAZ:
  //   "motion"    -> UMA por projetil. Decide a DIRECAO e PRESERVA o modulo da
  //                  velocidade. Uma segunda motion SUBSTITUI a primeira.
  //                  Tipos: Path, Tracking, Wobble, MiraPeriodica
  //   "modifiers" -> QUANTAS QUISER. Mudam o MODULO ou agendam coisas, e
  //                  ACUMULAM.
  //                  Tipos: Accelerate, SlowDown, Activate, Deactivate,
  //                         PulsoDeVelocidade
  //   "animacao"  -> nome de uma animacao registrada na fabrica do projetil
  //
  // A separacao entre motion e modifier e garantida pelo COMPILADOR no C++
  // (static_assert em insertMotion/insertModifier). Aqui ela e conferida na
  // leitura, porque arquivo de texto nao passa por compilador: por um Modifier
  // em "motion" e a regra e recusada com uma frase dizendo o porque.
  //
  // Em "motion" do tipo Path, "velocidade" e a velocidade COM QUE O CAMINHO E
  // PERCORRIDO, e nao a do disparo. A 340-400 px/s um laco vira um risco na
  // tela; por isso quase todo caminho usa uma velocidade menor que a do ataque.
  // ==========================================================================

  // --------------------------------------------------------------------------
  // SALLES - INF 213
  // --------------------------------------------------------------------------

  // FASE 1 - lista encadeada simples. NAO TEM REGRA DE CAMINHO, e esse e o ponto.
  //
  // A fila de nos e feita pela propria WaveAttack: ela da a cada projetil um
  // DeactivateBehavior(0) e um ActivateBehavior(i * intervalo), ou seja, o no i
  // desperta i*intervalo segundos depois do primeiro, todos na mesma direcao e
  // todos saindo do mesmo ponto. O espacamento e velocidade x intervalo.

  "salles_lista_simples": [
    { "animacao": "ListaSimples" }
  ],

  // FASE 2 - lista duplamente encadeada: vai rapido e VOLTA.
  //
  // A mesma WaveAttack forma a fila, e UM caminho faz a fila inteira voltar.
  //
  // O "atraso": 0.85 E O NUMERO CRITICO desta fase. Ele tem de ser MAIOR que o
  // despertar do ultimo no (8 nos x 0.10 = 0.70s). Se for menor, o caminho ativa
  // num no que ainda esta parado, com velocidade zero, e sem direcao para capturar
  // ele cai na rotacao identidade - o no voa para a direita em vez de seguir a
  // fila. Mexer em "projeteis" ou "intervalo" em fases.json OBRIGA a revisar este
  // atraso.
  //
  // Como todos os nos ativam o caminho no MESMO instante, cada um a partir da
  // posicao onde estava, a fila vira em bloco e volta em formacao. Isso e o
  // ponteiro prev: a lista duplamente encadeada e a unica que pode ser percorrida
  // de tras para frente, e e a unica fase em que os tiros voltam.
  "salles_lista_dupla": [
    { "motion": { "tipo": "Path", "forma": "IdaEVolta",
                  "velocidade": 500, "atraso": 1.2,
                  "pararNoPonto": 0, "pararPor": 0.8 } }
  ],

  // FASE 3 - arvore binaria: a busca descendo da raiz.
  //
  // UMA REGRA SO, para oito folhas. "formaPorIndice" entrega ao projetil numero i
  // a forma numero i da familia "ArvoreDeBusca", declarada em formas.json. Antes
  // eram quatro regras por indice que tinham de bater com quatro formas escritas a
  // mao; mudar a profundidade da arvore mexia em tres lugares.
  //
  // Agora a arvore inteira e "divisoes": 3 em formas.json, e aqui nao ha numero
  // nenhum para acertar junto.
  //
  // "mira": "MirarNoJogador" planta a RAIZ apontada para o jogador, e com atraso
  // zero todas as quatro miram do mesmo ponto, entao a arvore inteira gira junto e
  // a geometria nao se desfaz. Sem isso ela crescia na direcao que o Salles
  // sorteia (0 a 180 graus em CustomizeAttackParams, no C++), e metade das vezes
  // saia de lado sem ameacar ninguem. Medindo: a fase passava 0.22 por segundo a
  // menos de 120px do jogador contra 0.42 do desenho anterior.

  "salles_arvore": [
    { "motion": { "tipo": "Path", "formaPorIndice": "ArvoreDeBusca", "velocidade": 360,
                  "mira": "MirarNoJogador" },
      "animacao": "Arvore" }
  ],

  // FASE FINAL - lista circular
  //
  // O professor coloca capivara em todo exercicio, entao a repescagem e um anel de
  // capivaras em que cada uma fecha um laco: a lista que volta ao inicio. O laco e
  // lento de proposito - a 400px/s ele vira um borrao e o jogador nao ve o circulo
  // fechar, que e a graca.
  //
  // A arte "Homing" (capivara vermelha) avisa que a bala vai curvar.
  "salles_lista_circular": [
    { "motion": { "tipo": "Path", "forma": "LacoLento", "velocidade": 175 },
      "animacao": "Homing" }
  ],

  // Fase final, segundo ataque: o anel rapido e reto, sem caminho. Existe para o
  // jogador nao poder ficar parado esperando os lacos passarem.
  "salles_anel_reto": [
    { "animacao": "Normal" }
  ],

  // --------------------------------------------------------------------------
  // RICARDO - INF 250
  // --------------------------------------------------------------------------

  // Fase 2: o anel sai reto, DESACELERA, e so depois de 1.5s vira na direcao do
  // jogador. Path com a forma Reta e mira no jogador e exatamente o que o antigo
  // HomingBehavior fazia - provado em tests/test_motion_contract.cpp.
  //
  // ATENCAO A ORDEM DOS PARAMETROS: o Homing era (atraso, velocidade); aqui sao
  // campos com nome, entao a troca nao acontece mais em silencio.
  //
  // O par SlowDown + Path e o exemplo mais limpo de por que Motion e Modifier
  // sao coisas separadas: o Path so gira, o SlowDown so muda o modulo, e nenhum
  // dos dois desfaz o outro.
  "ricardo_fase2": [
    { "modifiers": [ { "tipo": "SlowDown", "atraso": 1.3, "fator": 0.8 } ],
      "motion": { "tipo": "Path", "forma": "Reta", "velocidade": 180,
                  "atraso": 1.5, "mira": "MirarNoJogador" } }
  ],

  // Fase 3: METADE do anel vira para o jogador e a outra metade segue reta. O
  // jogador consegue ler quais balas vao atras dele, e e isso que torna um anel
  // de 18 atravessavel.
  "ricardo_fase3": [
    { "quando": "pares",
      "motion": { "tipo": "Path", "forma": "Reta", "velocidade": 200,
                  "atraso": 1.0, "mira": "MirarNoJogador" } }
  ],

  // Fase final, segundo ataque: o anel esparso de 9, que desacelera antes e
  // corrige depois.
  "ricardo_final_teleguiado": [
    { "modifiers": [ { "tipo": "SlowDown", "atraso": 0.8, "fator": 0.8 } ],
      "motion": { "tipo": "Path", "forma": "Reta", "velocidade": 240,
                  "atraso": 1.0, "mira": "MirarNoJogador" } }
  ],

  // --------------------------------------------------------------------------
  // JULIO - INF 420
  // --------------------------------------------------------------------------

  // Fase 2: forca diferente entre par e impar. O jogador ve dois comportamentos
  // no mesmo anel e aprende a distinguir qual bala corrige mais.
  "julio_fase2": [
    { "quando": "pares",
      "motion": { "tipo": "Tracking", "atraso": 0.3, "forca": 3.2, "duracao": 2.4 } },
    { "quando": "impares",
      "motion": { "tipo": "Tracking", "atraso": 0.3, "forca": 1.4, "duracao": 2.4 } }
  ],

  // Fase 3, primeiro ataque: voa reto 0.8s (o jogador VE que o tiro foi
  // adiantado) e depois da UMA correcao curta de 0.7s.
  //
  // A correcao e deliberadamente fraca e limitada. Se fosse uma perseguicao de
  // verdade, ela desfaria o contrajogo da previsao: a licao da fase e "seja
  // imprevisivel", e uma bala que corrige de qualquer jeito faz ser imprevisivel
  // deixar de ajudar. Fraca assim, o jogador ganha DOIS tempos de desvio, e a
  // leitura fica "ele errou a previsao e tentou consertar na marra".
  "julio_fase3_previsao": [
    { "escala": 2,
      "motion": { "tipo": "Tracking", "atraso": 0.8, "forca": 1.6, "duracao": 0.7 } }
  ],

  // Fase final: um anel de 6, cada um dando uma volta antes de seguir em frente.
  // Como o PathBehavior alinha o caminho com a direcao inicial de cada projetil,
  // a MESMA forma sai girada de um jeito diferente para cada ponto do anel: seis
  // lacos apontando para fora, sem escrever seis caminhos.
  "julio_final_laco": [
    { "motion": { "tipo": "Path", "forma": "LacoApertado", "velocidade": 650 } }
  ],


  "andre_tres": [
    {
      "chance": 0.2,
      "motion": {"tipo": "Tracking", "atraso":  2.0, "forca": 2, "duracao":  2}
    }
  ],

  // --------------------------------------------------------------------------
  // EXEMPLOS - nenhum chefe usa, servem de referencia para escrever regras
  // --------------------------------------------------------------------------

  "exemplo_teleguiado": [
    { "chance": 0.2,
      "motion": { "tipo": "Path", "forma": "Reta", "velocidade": 280,
                  "atraso": 1.2, "mira": "MirarNoJogador" },
      "animacao": "Homing" }
  ],

  // A investida repetida: o projetil quase para, re-aponta, e da um mergulho
  // rapido. Precisa das DUAS pecas derivadas do MESMO ritmo - a Motion que gira
  // e o Modifier que pulsa o modulo. Repare que o ritmo aparece duas vezes:
  // mudar um e esquecer o outro faz a mirada acontecer fora do mergulho.
  "exemplo_cacador": [
    { "motion": { "tipo": "MiraPeriodica",
                  "ritmo": { "investida": 0.2, "pausa": 1.0, "repeticoes": 6 } },
      "modifiers": [
        { "tipo": "PulsoDeVelocidade",
          "ritmo": { "investida": 0.2, "pausa": 1.0, "repeticoes": 6 },
          "investida": 640, "pausa": 15 }
      ] }
  ],

  // --------------------------------------------------------------------------
  // THIAGO - INF 220
  // --------------------------------------------------------------------------
  //
  // NENHUMA DESTAS REGRAS TEM "motion", E NAO E ESQUECIMENTO.
  //
  // A ConsultaAttack faz o projetil nascer PARADO, visivel, na borda da faixa, e
  // so lhe da velocidade depois do aviso - e esse intervalo e o telegrafo. Toda
  // Motion captura a direcao do projetil no instante em que ativa; se uma delas
  // ativasse durante a espera, encontraria velocidade zero, nao teria direcao
  // para capturar e cairia na rotacao identidade - o projetil sairia para a
  // direita em vez de varrer a faixa.
  //
  // E o mesmo problema do "atraso": 0.85 do salles_duplamente, so que aqui a
  // espera nao e de alguns decimos: e o ataque inteiro. Por isso estas regras
  // mexem so em aparencia.

  // A varredura comum, das fases 1 a 3.
  "thiago_varredura": [
    { "animacao": "Linha", "escala": 2 }
  ],

  // O desfazimento da fase 3: a mesma celula, menor.
  //
  // O tamanho e o que distingue as duas consultas em tela. A que vem desfazendo
  // precisa ser LEGIVEL como outra coisa, senao o jogador ve so "mais balas" e
  // nao "a varredura esta voltando" - e a fase inteira existe para ensinar isso.
  "thiago_desfazimento": [
    { "animacao": "Linha", "escala": 1.5 }
  ],

  // A juncao da fase final: as colunas do produto cartesiano, maiores que as
  // linhas para que a treliça tenha dois pesos visuais e de para ler qual eixo
  // esta fechando primeiro.
  "thiago_juncao": [
    { "animacao": "Linha", "escala": 2.5 }
  ]
}
