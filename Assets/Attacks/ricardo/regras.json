{
  // As regras de projetil do Ricardo. Uma pasta por chefe: Assets/Attacks/ricardo/.

  // Fase 1: a palavra nasce no posto "palavra" - os bits que ainda nao passaram pela porta - e a
  // fileira de portas no posto "portas".
  "palavra": [
    { "posto": "palavra" }
  ],
  "portas": [
    { "posto": "portas" }
  ],

  // Fase 2: todo bit do leque nasce no posto "registradores" - e e por ele que o Ricardo os acha
  // para dar o passo de cada borda do clock.
  "registradores": [
    { "posto": "registradores" }
  ],

  // Fase 3: as molduras dos estagios e os chips das instrucoes nascem nos postos em que o Ricardo
  // os procura - "estagios" e "pipeline".
  "estagios": [
    { "posto": "estagios" }
  ],
  "pipeline": [
    { "posto": "pipeline" }
  ],
  "resultado": [
    { "animacao": "Um" }
  ],

  // Fase final: as quatro placas do Blink, presas ao professor duas de cada lado e um pouco abaixo
  // dele, no posto "placas".
  "placas": [
    { "indices": [0], "posto": "placas",
      "motion": { "tipo": "Ancorar", "dx": -210, "dy": 30,  "duracao": 7.5, "velocidade": 220 } },
    { "indices": [1], "posto": "placas",
      "motion": { "tipo": "Ancorar", "dx": -120, "dy": 100, "duracao": 7.5, "velocidade": 220 } },
    { "indices": [2], "posto": "placas",
      "motion": { "tipo": "Ancorar", "dx": 120,  "dy": 100, "duracao": 7.5, "velocidade": 220 } },
    { "indices": [3], "posto": "placas",
      "motion": { "tipo": "Ancorar", "dx": 210,  "dy": 30,  "duracao": 7.5, "velocidade": 220 } }
  ]
}
