{
  // ==========================================================================
  // AS REGRAS DE PROJETIL DO RICARDO
  //
  // UMA PASTA POR CHEFE: Assets/Attacks/ricardo/. Cada chave e um conjunto de
  // regras, e e por esse nome que um ataque do fases.json ao lado o pede:
  //     "regras": "fase2"
  //
  // OS NOMES PERDERAM O PREFIXO DO PROFESSOR. Eram "fase2" porque
  // um arquivo so com todos os conjuntos precisava evitar colisao; com uma pasta
  // por chefe, o prefixo passou a repetir o nome da pasta.
  //
  // UMA REGRA = uma motion (como o projetil se move), modifiers (o que muda nele
  // com o tempo), uma animacao e uma chance. Tudo opcional: regra so com
  // "animacao" existe e e legitima.
  //
  // OS CAMPOS estao documentados em Documentacao/arquivos-de-dados.md.
  // ==========================================================================
  // --------------------------------------------------------------------------
  // RICARDO - INF 250
  // --------------------------------------------------------------------------

  // FASE 1: a palavra nasce no posto "palavra" - os bits que ainda nao
  // passaram pela porta - e a fileira de portas no posto "portas". Quem os
  // procura nos postos e o Ricardo: a cada quadro ele poe a cara da etapa em
  // cada porta e passa pela porta todo bit que chegou a altura dela, que entao
  // deixa o posto.
  "palavra": [
    { "posto": "palavra" }
  ],
  "portas": [
    { "posto": "portas" }
  ],

  // Fase 2: o anel sai reto, DESACELERA, e so depois de 1.5s vira na direcao do
  // jogador. Path com a forma Reta e mira no jogador e exatamente o que o antigo
  // HomingBehavior fazia - provado em tests/test_motion_contract.cpp.
  //
  // ATENCAO A ORDEM DOS PARAMETROS: o Homing era (atraso, velocidade); aqui sao
  // campos com nome, entao a troca nao acontece mais em silencio.
  //
  // O par SlowDown + Path e o exemplo mais limpo de por que Motion e Modifier
  // sao coisas separadas: o Path so gira, o SlowDown so muda o modulo, e nenhum
  // dos dois desfaz o outro.
  "fase2": [
    { "modifiers": [ { "tipo": "SlowDown", "atraso": 1.3, "fator": 0.8 } ],
      "motion": { "tipo": "Path", "forma": "Reta", "velocidade": 180,
                  "atraso": 1.5, "mira": "MirarNoJogador" } }
  ],

  // Fase 3: METADE do anel vira para o jogador e a outra metade segue reta. O
  // jogador consegue ler quais balas vao atras dele, e e isso que torna um anel
  // de 18 atravessavel.
  "fase3": [
    { "quando": "pares",
      "motion": { "tipo": "Path", "forma": "Reta", "velocidade": 200,
                  "atraso": 1.0, "mira": "MirarNoJogador" } }
  ],

  // Fase final, segundo ataque: o anel esparso de 9, que desacelera antes e
  // corrige depois.
  "final_teleguiado": [
    { "modifiers": [ { "tipo": "SlowDown", "atraso": 0.8, "fator": 0.8 } ],
      "motion": { "tipo": "Path", "forma": "Reta", "velocidade": 240,
                  "atraso": 1.0, "mira": "MirarNoJogador" } }
  ]
}
