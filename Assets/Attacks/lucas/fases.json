{
  // As fases do Lucas (INF 321 - Programacao Web). Quase tudo e de gatilho: quem decide quando cada
  // coisa nasce e onde e o Lucas.cpp (Dom.h, Masmorra.h e Fenix.h dizem as contas), e aqui fica so
  // a forma de cada disparo.

  // Fase 1 - CSS: a <div> que as regras mudam | gesto: o professor no alto, de um lado ao outro.
  "StateOne": {
    "duracao": 20,
    "proximo": "StateTwo",
    "anuncio": "<div id=\"prova\"></div>",
    "movimento": { "tipo": "Conduzido", "a": 320 },
    "ataques": [
      // Cada peca invisivel que faz a <div> machucar em toda a area dela.
      { "gatilho": "peca", "estrategia": "WaveAttack", "projetil": "Peca",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0, "som": false },
      // A regra de CSS que ele joga no campo (o rumo e a velocidade vem do Lucas.cpp).
      { "gatilho": "regra", "estrategia": "WaveAttack", "projetil": "Regra",
        "projeteis": 1, "velocidade": 170, "angulo": 0, "intervalo": 0 },
      // O leque de tags do proprio professor, mirado.
      { "gatilho": "tag", "estrategia": "WaveAttack", "projetil": "Codigo",
        "projeteis": 5, "velocidade": 230, "angulo": 40, "intervalo": 0,
        "regras": "html" }
    ]
  },

  // Fase 2 - JavaScript: a mesma <div>, agora com comportamento.
  "StateTwo": {
    "duracao": 20,
    "proximo": "StateThree",
    "anuncio": "document.querySelector(\"div\")",
    "movimento": { "tipo": "Conduzido", "a": 320 },
    "ataques": [
      { "gatilho": "peca", "estrategia": "WaveAttack", "projetil": "Peca",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0, "som": false },
      { "gatilho": "regra", "estrategia": "WaveAttack", "projetil": "Regra",
        "projeteis": 1, "velocidade": 170, "angulo": 0, "intervalo": 0 },
      { "gatilho": "tag", "estrategia": "WaveAttack", "projetil": "Codigo",
        "projeteis": 5, "velocidade": 230, "angulo": 40, "intervalo": 0,
        "regras": "html" },
      // setInterval(atirar): o anel de promessas que sai da <div>, para e acelera.
      { "gatilho": "setinterval", "estrategia": "CircleSpreadAttack", "projetil": "Codigo",
        "projeteis": 8, "velocidade": 170, "variar": { "giro": 20 },
        "regras": "promessas" },
      // setTimeout(explodir): a <div> estoura.
      { "gatilho": "explosao", "estrategia": "CircleSpreadAttack", "projetil": "Codigo",
        "projeteis": 14, "velocidade": 210, "variar": { "giro": 12 },
        "regras": "html" },
      // div.onclick = revidar: o tiro do aluno na <div> volta como leque.
      { "gatilho": "revide", "estrategia": "WaveAttack", "projetil": "Codigo",
        "projeteis": 3, "velocidade": 260, "angulo": 30, "intervalo": 0,
        "regras": "css" }
    ]
  },

  // Fase 3 - Elixir: a sala de masmorra | gesto: o professor anda ate o bau.
  "StateThree": {
    "duracao": 20,
    "proximo": "",
    "anuncio": "É perigoso ir sozinho!",
    "movimento": { "tipo": "Conduzido", "a": 420 },
    "ataques": [
      { "gatilho": "gosma", "estrategia": "WaveAttack", "projetil": "Gosma",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0, "som": false },
      // A chave, o bau e o Elixir: enfeites, que o aluno pega.
      { "gatilho": "item", "estrategia": "WaveAttack", "projetil": "Item",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0, "som": false },
      // O leque com que ele atrapalha a cacada.
      { "gatilho": "leque", "estrategia": "WaveAttack", "projetil": "Codigo",
        "projeteis": 3, "velocidade": 230, "angulo": 30, "intervalo": 0,
        "regras": "mensagem" },
      // A furia de quem bebeu o Elixir: cada braco da espiral e o anel.
      { "gatilho": "furia", "estrategia": "WaveAttack", "projetil": "Codigo",
        "projeteis": 1, "velocidade": 170, "angulo": 0, "intervalo": 0, "som": false,
        "regras": "pipe" },
      { "gatilho": "anel_furia", "estrategia": "CircleSpreadAttack", "projetil": "Codigo",
        "projeteis": 12, "velocidade": 170, "variar": { "giro": 15 },
        "regras": "mensagem" }
    ]
  },

  // Fase final - Phoenix: a fenix | gesto: o professor no alto.
  "StateFinal": {
    "duracao": 20,
    "proximo": "StateOne",
    "anuncio": "mix phx.server",
    "movimento": { "tipo": "Conduzido", "a": 300 },
    "ataques": [
      { "gatilho": "fenix", "estrategia": "WaveAttack", "projetil": "Fenix",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0, "som": false },
      { "gatilho": "cinzas", "estrategia": "WaveAttack", "projetil": "Cinzas",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0, "som": false },
      // As penas de fogo, num leque para baixo.
      { "gatilho": "pena", "estrategia": "WaveAttack", "projetil": "Pena",
        "projeteis": 4, "velocidade": 200, "angulo": 50, "anguloCentral": 90, "intervalo": 0 },
      // O broadcast do PubSub: o anel de cada socket.
      { "gatilho": "socket", "estrategia": "CircleSpreadAttack", "projetil": "Codigo",
        "projeteis": 8, "velocidade": 150, "variar": { "giro": 22.5 },
        "regras": "mensagem" },
      // O renascimento: o anel de fogo que sai das cinzas.
      { "gatilho": "renascer", "estrategia": "CircleSpreadAttack", "projetil": "Pena",
        "projeteis": 16, "velocidade": 190, "variar": { "giro": 11 } },
      { "gatilho": "tag", "estrategia": "WaveAttack", "projetil": "Codigo",
        "projeteis": 3, "velocidade": 230, "angulo": 30, "intervalo": 0,
        "regras": "html" }
    ]
  }
}
