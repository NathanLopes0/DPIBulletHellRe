{
  // As regras de projetil do Lucas. Um conjunto por camada da web.

  // HTML: a tag vai reta. A estrutura nao corre atras de ninguem - ela ocupa espaco.
  "html": [
    { "animacao": "Tag" }
  ],

  // CSS: a regra tambem vai reta (o revide do onclick).
  "css": [
    { "animacao": "Regra" }
  ],

  // JavaScript: a promessa do setInterval da <div> - para, e depois vai de vez.
  "promessas": [
    { "animacao": "Promessa",
      "modifiers": [
        { "tipo": "SlowDown", "atraso": 0.7, "fator": 0.0 },
        { "tipo": "Promessa", "atraso": 1.5, "resolve": 0.6, "velocidade": 280, "escreve": "Tag" } ] }
  ],

  // JavaScript: o estouro do setTimeout - promessas que saem de vez, sem parar.
  "estouro": [
    { "animacao": "Promessa" }
  ],

  // Elixir: a mensagem - o leque da cacada, o anel da furia e o do socket do Phoenix.
  "mensagem": [
    { "animacao": "Mensagem" }
  ],

  // Elixir: o |> de cada braco da espiral da furia.
  "pipe": [
    { "animacao": "Pipe" }
  ]
}
