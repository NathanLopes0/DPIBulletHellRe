{
  // ==========================================================================
  // AS REGRAS DE PROJETIL DO LUCAS
  //
  // Um conjunto por camada da web. Os campos estao documentados em
  // Documentacao/arquivos-de-dados.md.
  // ==========================================================================

  // HTML: a tag vai reta. A estrutura nao corre atras de ninguem - ela ocupa
  // espaco.
  "html": [
    { "animacao": "Tag" }
  ],

  // CSS: a regra tambem vai reta. O que o CSS faz e REARRANJAR o que ja esta
  // na tela, e isso e da estrategia, nao do projetil.
  "css": [
    { "animacao": "Regra" }
  ],

  // JAVASCRIPT: A PROMESSA. Sai no leque, para pendente aos 0,7s (SlowDown com
  // fator zero) e assenta aos 1,5s: a parte que resolve e 0,6, e as resolvidas
  // saem contra o aluno a 280 px/s, ja como TAG - o fetch voltou com HTML -;
  // as outras sao rejeitadas e somem (Promessa, ver Promessa.h). Numa final
  // medida, 37 das 70 promessas resolveram. Parada, uma promessa nunca sairia da
  // tela; e o assentar, resolvendo ou rejeitando, que a tira de la.
  "promessas": [
    { "animacao": "Promessa",
      "modifiers": [
        { "tipo": "SlowDown", "atraso": 0.7, "fator": 0.0 },
        { "tipo": "Promessa", "atraso": 1.5, "resolve": 0.6, "velocidade": 280, "escreve": "Tag" } ] }
  ],

  // ELIXIR: o processo vai atras do aluno, devagar e por bastante tempo. Um
  // processo e leve e insistente: nao corre, mas nao desiste cedo.
  "processos": [
    { "motion": { "tipo": "Tracking", "atraso": 0.4, "forca": 1.2, "duracao": 3.0 } }
  ]
}
