{
  // ==========================================================================
  // AS REGRAS DE PROJETIL DO LUCAS
  //
  // Um conjunto por camada da web. Os campos estao documentados em
  // Documentacao/arquivos-de-dados.md.
  // ==========================================================================

  // HTML: a tag vai reta. A estrutura nao corre atras de ninguem - ela ocupa
  // espaco.
  "html": [
    { "animacao": "Tag" }
  ],

  // CSS: a regra tambem vai reta. O que o CSS faz e REARRANJAR o que ja esta
  // na tela, e isso e da estrategia, nao do projetil.
  "css": [
    { "animacao": "Regra" }
  ],

  // JAVASCRIPT: A PROMESSA - o leque do .then e o anel da resposta do fetch,
  // no event loop da final. Sai, para pendente aos 0,7s (SlowDown com fator
  // zero) e assenta aos 1,5s: a parte que resolve e 0,6, e as resolvidas saem
  // contra o aluno a 280 px/s, ja como TAG - o fetch voltou com HTML -; as
  // outras sao rejeitadas e somem (Promessa, ver Promessa.h). Parada, uma
  // promessa nunca sairia da tela; e o assentar, resolvendo ou rejeitando, que
  // a tira de la.
  "promessas": [
    { "animacao": "Promessa",
      "modifiers": [
        { "tipo": "SlowDown", "atraso": 0.7, "fator": 0.0 },
        { "tipo": "Promessa", "atraso": 1.5, "resolve": 0.6, "velocidade": 280, "escreve": "Tag" } ] }
  ],

  // A PAGINA DA FASE 1: o cursor e o spinner ficam no posto "pagina" - e por
  // la que o F5 os acha para apagar -, e o Lucas os move (Lucas::RenderizarPagina).
  "pagina": [
    { "posto": "pagina" }
  ],
  "spinner": [
    { "posto": "pagina", "animacao": "Promessa" }
  ],

  // O DEVTOOLS DA FASE 2: os cartoes da grade ficam no posto "grade", e o
  // Lucas os move para onde o CSS de agora manda (Lucas::AtualizarEstilo).
  "grade": [
    { "posto": "grade", "animacao": "Regra" }
  ],

  // O HANDLE_CAST DA FASE 3: o leque de envelopes do worker que processou a
  // caixa cheia.
  "mensagem": [
    { "animacao": "Mensagem" }
  ],

  // O PIPE DA FASE 3: cada etapa do |> que escorre embaixo do supervisor
  // parado. Ladrilho cheio, e nao envelope: o envelope que corre pela linha
  // da arvore e o cast, que nao machuca.
  "pipe": [
    { "animacao": "Pipe" }
  ],

  // A ARVORE DE SUPERVISAO DA FASE 3: os workers e as mensagens que correm ate
  // eles ficam no posto "supervisao", e o Lucas os move (Lucas::AtualizarSupervisao).
  "worker": [
    { "posto": "supervisao" }
  ],
  "cast": [
    { "posto": "supervisao", "animacao": "Mensagem" }
  ],

  // O EVENT LOOP DA FINAL: a ficha de cada linha do script fica no posto
  // "eventloop", e o Lucas a leva da pilha as Web APIs e as filas
  // (Lucas::AtualizarEventLoop). A animacao e a do tipo da linha, posta por ele.
  "ficha": [
    { "posto": "eventloop" }
  ]
}
