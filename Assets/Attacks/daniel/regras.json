{
  // As regras de projetil do Daniel (INF 425 - Ciencia de Dados, optativa).

  // A roleta dos tipos, no sorteio: o tiro sai devagar, e os tres bracos se leem perto do
  // professor; depois de um tempo ele dispara.
  "roleta": [
    { "modifiers": [ { "tipo": "Accelerate", "atraso": 0.7, "fator": 1.6 } ] }
  ],

  // Os dados de treino da fase 3, que nascem na fronteira e sao empurrados para um lado: vao
  // balancando, como dado com ruido.
  "empurrada": [
    { "motion": { "tipo": "Wobble", "amplitude": 24, "frequencia": 1.5, "duracao": 8.0 } }
  ]
}
