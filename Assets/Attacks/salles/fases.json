{
  // ==========================================================================
  // AS FASES DO SALLES
  //
  // UMA PASTA POR CHEFE: Assets/Attacks/salles/. A fabrica dele pede as fases
  // pelo nome da pasta:
  //     ConfigurarFasesDeArquivo(boss, fsm, "salles")
  //
  // OS NOMES DE FASE NAO SAO LIVRES. A maquina de estados procura os estados
  // por TEXTO, e so estes quatro existem:
  //     StateOne, StateTwo, StateThree, StateFinal
  // Um nome inventado e recusado na leitura, porque a fase existiria no arquivo
  // sem nunca ser alcancada.
  //
  // StateFinal E OBRIGATORIO, mesmo num chefe de tres fases. Se a nota ficar
  // entre 40 e 59 ao fim da terceira fase, a FSM vai para StateFinal; sem o
  // estado, ela apenas registra um erro no log e O CHEFE CONGELA - sem travar o
  // jogo e sem avisar em tela. Isso ja custou depuracao uma vez.
  //
  // "proximo" vazio ou ausente significa "a batalha e decidida ao fim desta
  // fase" (ver BossAttackState), e nao "fim do arquivo".
  //
  // OS CAMPOS de um ataque e do movimento estao documentados em
  // Documentacao/arquivos-de-dados.md. Dois merecem lembrete aqui:
  //
  //   CAMPO OMITIDO = PADRAO DO MOTOR. A ponte so escreve no AttackParams o que
  //   este arquivo disser; nao ha valor "zero por omissao" nenhum.
  //
  //   anguloCentral pode ser SOBRESCRITO pelo chefe em tempo de execucao, no
  //   CustomizeAttackParams dele - e o unico pedaco do balanceamento que ainda
  //   vive em C++. Onde isso acontece esta anotado na fase.
  //
  // ---- EM ABERTO: O JOGADOR PARADO APROVA AQUI ----------------------------
  //
  // Ferramentas/parado-reprova.sh: sete chefes reprovam o piloto que nao se
  // mexe, e o Salles o aprova com 80,70 - 15 acertos sofridos e 309 dados, o
  // maior numero de acertos dados entre os oito. A causa e o GoToCenter das
  // fases 1, 3 e final: parado no meio da tela, ele fica na coluna de quem
  // atira para cima, e a nota sobe sozinha.
  //
  // A cura e a mesma do Vladimir, dar um gesto a cada fase - e aqui o gesto tem
  // o que dizer, porque cada fase e uma estrutura de dados:
  //
  //   fase 1      lista encadeada     varredura - a travessia tem direcao
  //   fase 2      lista dupla         varredura que INVERTE - ida e volta
  //   fase 3      arvore binaria      mergulho - a profundidade e o nivel
  //   final       lista circular      orbita - o laco que fecha
  //
  // A CAPIVARA APARECE EM QUALQUER FASE (Capivara.h). O Salles poe capivara em
  // todo exercicio, e em seis de cada dez fases ela atravessa o campo, uma vez,
  // num instante sorteado entre 4 e 10 segundos, andando de uma borda a outra a
  // 170 px/s. Ela e um ABRIGO: come os projeteis dele e os tiros do aluno. Por
  // isso toda fase tem o ataque de gatilho "capivara" - quem o puxa e o Salles,
  // e o placar avisa "uma capivara apareceu!".
  //
  // ANTES DE MEXER: a rede de regressao quadro a quadro (provaigual.sh, fora
  // do repositorio) roda a BATALHA 0, QUE E A DO ANDRE - nao a do Salles, por
  // mais que comentarios antigos digam o contrario. O Salles nao tem rede:
  // grave uma referencia da batalha 1 antes de mexer no balanceamento dele.
  // ==========================================================================

  // FASE 1 - A PILHA   |   gesto: DE COLUNA EM COLUNA
  //
  // A PILHA ESTA PENDURADA NO PROFESSOR (Pilha.h). A cada 0,7s o programa da
  // a operacao, e o placar a escreve: push(7) poe um bloco numerado na ponta de
  // baixo - o TOPO -, e pop() -> 7 tira o topo e o atira no aluno, e o bloco
  // estoura no caminho num leque de tantas lascas quanto o numero dele, mirado
  // no aluno: o placar diz o tamanho do leque que vem. LIFO: o ultimo
  // que entra e o primeiro que sai, e o topo e sempre o bloco de baixo.
  //
  // O ALUNO TAMBEM DA POP, A TIRO: o tiro dele acerta primeiro o bloco de baixo,
  // e tres tiros o derrubam. So da para tirar o topo - a pilha pela geometria -,
  // e enquanto ela esta pendurada, e a armadura do professor.
  //
  // STACK OVERFLOW: com cinco blocos, o push seguinte derruba a pilha inteira,
  // aberta em leque, em cima de quem estiver embaixo.
  //
  // ELE VAI DE COLUNA EM COLUNA e para 2,6s em cada uma (o movimento
  // "Conduzido"): parado, ele leva tiro; e andando, a pilha pendurada varre o
  // campo.
  "StateOne": {
    "duracao": 17,
    "proximo": "StateTwo",
    "anuncio": "pilha: LIFO",
    "movimento": { "tipo": "Conduzido", "a": 300 },
    "ataques": [
      { "gatilho": "capivara", "estrategia": "WaveAttack", "projetil": "Capivarona",
        "projeteis": 1, "velocidade": 170, "angulo": 0, "intervalo": 0 },
      { "gatilho": "push", "estrategia": "WaveAttack", "projetil": "Bloco",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0,
        "regras": "pilha" },
      { "gatilho": "estourar", "estrategia": "WaveAttack", "projetil": "Lasca",
        "projeteis": 5, "velocidade": 240, "angulo": 80, "intervalo": 0 }
    ]
  },

  // FASE 2 - A TABELA HASH   |   gesto: O PROFESSOR VAI AO BALDE
  //
  // A TABELA ESTA NO ALTO DO CAMPO (Hash.h): m baldes lado a lado, e de cada um
  // pende a lista das chaves que cairam nele - encadeamento. A cada 0,75s, uma
  // operacao, e o placar a escreve por extenso:
  //
  //   INSERIR    h(23) = 23 mod 7 = 2: a chave sai do professor e vai para o
  //              fim da lista do balde 2. Duas no mesmo balde sao uma colisao,
  //              e a lista cresce para baixo.
  //   BUSCAR     busca(23): o professor percorre a lista do balde, no por no, e
  //              cada no lido atira um leque de tres no aluno - uma lista de
  //              muitas colisoes e uma rajada longa.
  //              Achando, a chave sai atirada no aluno; nao achando, o NULL do
  //              fim da lista cai pela coluna inteira. E quem limpou a propria
  //              coluna a tiro acha o NULL em cima dele: lista vazia, busca
  //              sem achar.
  //   REHASH     com mais chaves que baldes, a tabela cresce para o proximo primo
  //              (7, 11, 13, 17), e toda chave muda de balde na frente do aluno.
  //
  // O ALUNO REMOVE A TIRO: a chave e derrubavel com dois tiros, e o tiro que
  // sobe acerta primeiro o fim da lista.
  //
  // O PROFESSOR VAI AO BALDE DA OPERACAO (o movimento "Conduzido").
  "StateTwo": {
    "duracao": 17,
    "proximo": "StateThree",
    "anuncio": "h(k) = k mod m",
    "movimento": { "tipo": "Conduzido", "a": 700 },
    "ataques": [
      { "gatilho": "capivara", "estrategia": "WaveAttack", "projetil": "Capivarona",
        "projeteis": 1, "velocidade": 170, "angulo": 0, "intervalo": 0 },
      { "gatilho": "baldes", "estrategia": "WaveAttack", "projetil": "Balde",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0,
        "regras": "baldes" },
      { "gatilho": "chave", "estrategia": "WaveAttack", "projetil": "Chave",
        "projeteis": 1, "velocidade": 0, "angulo": 0, "intervalo": 0,
        "regras": "chaves" },
      { "gatilho": "percorrer", "estrategia": "WaveAttack", "projetil": "Percurso",
        "projeteis": 3, "velocidade": 280, "angulo": 30, "intervalo": 0 },
      { "gatilho": "nulo", "estrategia": "WaveAttack", "projetil": "Nulo",
        "projeteis": 1, "velocidade": 420, "angulo": 0, "anguloCentral": 90, "intervalo": 0 }
    ]
  },

  // FASE 3 - ARVORE BINARIA: uma busca descendo da raiz.
  //
  // AngledAttack com "angulo": 0, projeteis que saem sobrepostos
  //
  // GoToCenter e obrigatorio aqui. Com o chefe vagando, cada disparo plantaria a
  // raiz num lugar diferente e as arvores nao se acumulariam na mesma regiao - e
  // e o acumulo, disparo sobre disparo, que faz a tela parecer uma arvore e nao
  // quatro tiros tortos.
  //
  // "projeteis": 16 TEM de bater com as 16 folhas de "divisoes": 4 na familia
  // ArvoreDeBusca, em formas.json. E o unico numero que precisa andar junto, e um
  // teste confere: a mais, o projetil extra repete um ramo; a menos, metade da
  // arvore nao aparece.

  "StateThree": {
    "duracao": 17,
    // Vazio de proposito: e aqui que a batalha e decidida.
    "proximo": "",
    "movimento": { "tipo": "GoToCenter" },
    "ataques": [
      { "gatilho": "capivara", "estrategia": "WaveAttack", "projetil": "Capivarona",
        "projeteis": 1, "velocidade": 170, "angulo": 0, "intervalo": 0 },
      { "estrategia": "AngledAttack", "projetil": "Estruturas",
        "projeteis": 16, "velocidade": 210, "angulo": 0,
        "cooldown": 2.1,
        "regras": "arvore" }
    ]
  },

  // FASE FINAL - LISTA CIRCULAR, com as capivaras.
  //
  // Repescagem (nota entre 40 e 59 ao fim da fase 3). O professor coloca capivara
  // em todo exercicio da disciplina, entao a ultima fase e o anel de capivaras em
  // que cada uma fecha um laco e volta ao inicio: a lista circular.
  //
  // Dois ataques ao mesmo tempo, como no desenho anterior: o anel de lacos lentos
  // e um anel reto e rapido. O segundo existe para o jogador nao poder ficar
  // parado esperando os lacos passarem.
  //
  // CircleSpreadAttack ignora angulo, anguloCentral e intervalo - o anel e sempre
  // 360 graus divididos pela quantidade -, por isso nenhum dos tres aparece aqui.
  "StateFinal": {
    "duracao": 17,
    "proximo": "StateOne",
    "movimento": { "tipo": "GoToCenter" },
    "ataques": [
      { "gatilho": "capivara", "estrategia": "WaveAttack", "projetil": "Capivarona",
        "projeteis": 1, "velocidade": 170, "angulo": 0, "intervalo": 0 },
      { "estrategia": "CircleSpreadAttack", "projetil": "Capivara",
        "projeteis": 12, "velocidade": 200,
        "cooldown": 1.8,
        "regras": "lista_circular" },

      { "estrategia": "CircleSpreadAttack", "projetil": "Capivara",
        "projeteis": 8, "velocidade": 330,
        "cooldown": 2.4,
        "regras": "anel_reto" }
    ]
  }
}
